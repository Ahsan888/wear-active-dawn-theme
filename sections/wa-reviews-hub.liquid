{% comment %}
  Wear Active custom code start — wa-reviews-hub.liquid
  A brand-aligned landing page for Judge.me reviews and the photo-review reward.
{% endcomment %}

{{ 'wa-reviews-hub.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .wa-reviews-hub--{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .wa-reviews-hub--{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="wa-reviews-hub wa-reviews-hub--{{ section.id }}">
  <div class="wa-reviews-hub__inner">
    <header class="wa-reviews-hub__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="wa-reviews-hub__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="wa-reviews-hub__heading">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}

      {%- if section.settings.intro != blank -%}
        <p class="wa-reviews-hub__intro">{{ section.settings.intro | escape }}</p>
      {%- endif -%}
    </header>

    {%- if page.content != blank -%}
      <div class="wa-reviews-hub__page-content rte">
        {{ page.content }}
      </div>
    {%- endif -%}

    <div class="wa-reviews-hub__widget" aria-label="Wear Active customer reviews">
      {%- for block in section.blocks -%}
        {% render block %}
      {%- else -%}
        {%- if request.design_mode -%}
          <div class="wa-reviews-hub__editor-note">
            Add the Judge.me “Reviews Grid” or “All Reviews” app block here when you are ready to publish the
            reviews page.
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.show_reward -%}
      <aside class="wa-reviews-hub__reward" aria-labelledby="WaReviewReward-{{ section.id }}">
        <div class="wa-reviews-hub__reward-mark" aria-hidden="true">Rs.300</div>
        <div class="wa-reviews-hub__reward-copy">
          <p class="wa-reviews-hub__reward-label">PHOTO OR VIDEO REVIEW REWARD</p>
          <h2 id="WaReviewReward-{{ section.id }}" class="wa-reviews-hub__reward-heading">
            Share the fit. Get Rs.300 off.
          </h2>
          <p class="wa-reviews-hub__reward-text">
            Submit an honest, verified product review with a photo or video and receive Rs.300 off your next
            order of Rs.3,000 or more.
          </p>
          <ul class="wa-reviews-hub__reward-terms" role="list">
            <li>Every honest rating qualifies</li>
            <li>One reward per delivered order</li>
            <li>Unique code valid for 30 days</li>
            <li>Your face does not need to appear</li>
          </ul>

          {%- if section.settings.review_form_url != blank -%}
            <a class="wa-reviews-hub__reward-cta" href="{{ section.settings.review_form_url }}">
              {{ section.settings.review_cta_text | escape }}
              <span aria-hidden="true">→</span>
            </a>
          {%- endif -%}
        </div>
      </aside>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "WA reviews hub",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "CUSTOMER REVIEWS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real fit. Real feedback."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introduction",
      "default": "Verified feedback from customers who train, move and live in Wear Active."
    },
    {
      "type": "checkbox",
      "id": "show_reward",
      "label": "Show photo-review reward",
      "default": true
    },
    {
      "type": "url",
      "id": "review_form_url",
      "label": "Judge.me review form link",
      "info": "Paste the all-products review link from Judge.me. The button stays hidden while blank."
    },
    {
      "type": "text",
      "id": "review_cta_text",
      "label": "Review button label",
      "default": "Write a product review"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "WA reviews hub"
    }
  ]
}
{% endschema %}
