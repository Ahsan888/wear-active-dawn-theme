{{ 'wa-movement-gallery.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign wa_video_count = 0
  for block in section.blocks
    if block.settings.video != blank
      assign wa_video_count = wa_video_count | plus: 1
    endif
  endfor
-%}

{%- if wa_video_count > 0 or request.design_mode -%}
  {%- style -%}
    .wa-movement-gallery--{{ section.id }} { padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px; }
    @media screen and (min-width: 750px) { .wa-movement-gallery--{{ section.id }} { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; } }
  {%- endstyle -%}

  <section class="wa-movement-gallery wa-movement-gallery--{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width">
      <header class="wa-movement-gallery__header">
        {%- if section.settings.eyebrow != blank -%}<p class="wa-movement-gallery__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="wa-movement-gallery__heading {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<p class="wa-movement-gallery__text">{{ section.settings.text | escape }}</p>{%- endif -%}
      </header>

      {%- if wa_video_count > 0 -%}
        <div class="wa-movement-gallery__grid" style="--wa-video-count: {{ wa_video_count }}" aria-label="Wear Active in motion">
          {%- for block in section.blocks -%}
            {%- if block.settings.video != blank -%}
              {%- assign wa_link = block.settings.link -%}
              {%- if block.settings.product != blank -%}{%- assign wa_link = block.settings.product.url -%}{%- endif -%}
              <article class="wa-movement-gallery__card" {{ block.shopify_attributes }}>
                <div class="wa-movement-gallery__media">
                  {{ block.settings.video | video_tag: class: 'wa-movement-gallery__video', controls: true, autoplay: false, loop: false, muted: true, playsinline: true, preload: 'metadata', image_size: '800x' }}
                </div>
                <div class="wa-movement-gallery__caption">
                  <h3 class="wa-movement-gallery__title">{{ block.settings.title | default: block.settings.product.title | escape }}</h3>
                  {%- if wa_link != blank -%}<a class="wa-movement-gallery__link" href="{{ wa_link }}">Shop the look</a>{%- endif -%}
                </div>
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="wa-movement-gallery__editor-note">Add three to five short, vertical customer or creator videos to publish this section.</div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "WA movement videos",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "SEEN IN MOTION" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "See how it moves." },
    { "type": "select", "id": "heading_size", "label": "Heading size", "options": [{ "value": "h2", "label": "Small" }, { "value": "h1", "label": "Medium" }, { "value": "h0", "label": "Large" }], "default": "h1" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Real fit, fabric and movement—shown by the people who wear it." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 56 }
  ],
  "blocks": [
    { "type": "video", "name": "Video", "settings": [
      { "type": "video", "id": "video", "label": "Shopify-hosted video" },
      { "type": "text", "id": "title", "label": "Caption", "default": "Made to move" },
      { "type": "product", "id": "product", "label": "Featured product" },
      { "type": "url", "id": "link", "label": "Fallback link", "info": "Used when no featured product is selected." }
    ] }
  ],
  "presets": [{ "name": "WA movement videos", "blocks": [{ "type": "video" }, { "type": "video" }, { "type": "video" }] }]
}
{% endschema %}
