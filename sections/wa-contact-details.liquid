{% comment %}
  Wear Active custom code start — wa-contact-details.liquid
  Public, actionable support information for the contact page.
{% endcomment %}

{%- liquid
  assign wa_whatsapp_digits = settings.wa_whatsapp_number | remove: '+' | remove: ' ' | remove: '-'
  assign wa_whatsapp_message = 'Hi Wear Active, I need help.' | url_encode
-%}

<section class="wa-contact-details">
  <div
    class="page-width"
    style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
  >
    <header class="wa-contact-details__header">
      <p class="wa-contact-details__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2 class="wa-contact-details__heading">{{ section.settings.heading | escape }}</h2>
    </header>

    <div class="wa-contact-details__grid">
      <div class="wa-contact-details__card">
        <span class="wa-contact-details__label">WhatsApp</span>
        <span class="wa-contact-details__value">
          <a href="https://wa.me/{{ wa_whatsapp_digits }}?text={{ wa_whatsapp_message }}" target="_blank" rel="noopener">
            {{ settings.wa_whatsapp_number | escape }}
          </a>
        </span>
      </div>
      <div class="wa-contact-details__card">
        <span class="wa-contact-details__label">Email</span>
        <span class="wa-contact-details__value">
          <a href="mailto:{{ settings.wa_support_email | escape }}">{{ settings.wa_support_email | escape }}</a>
        </span>
      </div>
      <div class="wa-contact-details__card">
        <span class="wa-contact-details__label">Support hours</span>
        <span class="wa-contact-details__value">{{ settings.wa_support_hours | escape }}</span>
      </div>
      <div class="wa-contact-details__card">
        <span class="wa-contact-details__label">Response time</span>
        <span class="wa-contact-details__value">{{ settings.wa_support_reply_time | escape }}</span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "WA contact details",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "REAL SUPPORT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Talk to Wear Active"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 24,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 24,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "WA contact details"
    }
  ]
}
{% endschema %}
