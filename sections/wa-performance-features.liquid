{% comment %}
  Wear Active custom code start — wa-performance-features.liquid
  Premium homepage editorial performance section.
{% endcomment %}

{%- style -%}
  .wa-performance-features--{{ section.id }}.wa-performance-features {
    background-color: var(--wa-color-parchment);
    color: var(--wa-color-evergreen);
  }

  .wa-performance-features--{{ section.id }} .wa-performance-features__editorial {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 48rem;
    padding-top: {{ section.settings.padding_top | times: 0.6667 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.6667 | round: 0 }}px;
    padding-left: 2.4rem;
    padding-right: 2.4rem;
    overflow: hidden;
    background-color: var(--wa-color-evergreen);
    color: var(--wa-color-parchment);
    text-align: center;
  }

  .wa-performance-features--{{ section.id }} .wa-performance-features__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .wa-performance-features--{{ section.id }} .wa-performance-features__image,
  .wa-performance-features--{{ section.id }} .wa-performance-features__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .wa-performance-features--{{ section.id }} .wa-performance-features__placeholder {
    background-color: var(--wa-color-evergreen);
    opacity: 0.9;
  }

  .wa-performance-features--{{ section.id }} .wa-performance-features__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.12), rgba(0, 0, 0, 0.42)),
      var(--wa-color-black);
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }

  .wa-performance-features--{{ section.id }} .wa-performance-features__content {
    position: relative;
    width: min(100%, 52rem);
    margin: 0 auto;
    text-align: center;
  }

  .wa-performance-features--{{ section.id }} .wa-performance-features__content::before {
    content: 'WEAR ACTIVE';
    display: block;
    margin-bottom: 1.8rem;
    font-size: var(--wa-text-xs);
    font-weight: var(--wa-weight-medium);
    letter-spacing: 0.2em;
    line-height: var(--wa-leading-snug);
    text-transform: uppercase;
    color: rgba(var(--wa-color-parchment-rgb), 0.78);
  }

  .wa-performance-features--{{ section.id }} .wa-performance-features__heading {
    max-width: 52rem;
    margin: 0 auto;
    font-size: clamp(3.8rem, 12vw, calc(var(--font-heading-scale) * 6.4rem));
    font-weight: var(--wa-weight-extrabold);
    letter-spacing: var(--wa-tracking-snug);
    line-height: 0.96;
    text-transform: uppercase;
    color: inherit;
  }

  .wa-performance-features--{{ section.id }} .wa-performance-features__subheading {
    max-width: 48rem;
    margin: 2.4rem auto 0;
    font-size: var(--wa-text-md);
    font-weight: var(--wa-weight-regular);
    letter-spacing: var(--wa-tracking-normal);
    line-height: var(--wa-leading-relaxed);
    color: rgba(var(--wa-color-parchment-rgb), 0.82);
  }

  .wa-performance-features--{{ section.id }} .wa-performance-features__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 4.8rem;
    margin-top: 3.2rem;
    padding: 1.3rem 2.4rem;
    border: 0.1rem solid rgba(var(--wa-color-parchment-rgb), 0.86);
    color: var(--wa-color-parchment);
    background-color: transparent;
    font-size: var(--wa-text-sm);
    font-weight: var(--wa-weight-medium);
    letter-spacing: var(--wa-tracking-wide);
    line-height: var(--wa-leading-snug);
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 200ms ease, border-color 200ms ease, color 200ms ease;
  }

  .wa-performance-features--{{ section.id }} .wa-performance-features__cta[aria-disabled='true'] {
    cursor: default;
  }

  .wa-performance-features--{{ section.id }} .wa-performance-features__strip {
    padding: 3.6rem 0;
    background-color: var(--wa-color-parchment);
    border-top: 0.1rem solid rgba(var(--wa-color-evergreen-rgb), 0.1);
    border-bottom: 0.1rem solid rgba(var(--wa-color-evergreen-rgb), 0.1);
  }

  .wa-performance-features--{{ section.id }} .wa-performance-features__strip-inner {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .wa-performance-features--{{ section.id }} .wa-performance-features__list {
    display: grid;
    grid-auto-columns: max-content;
    grid-auto-flow: column;
    gap: 2.4rem;
    overflow-x: auto;
    scrollbar-width: none;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .wa-performance-features--{{ section.id }} .wa-performance-features__list::-webkit-scrollbar {
    display: none;
  }

  .wa-performance-features--{{ section.id }} .wa-performance-features__item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.2rem;
    min-width: 0;
  }

  .wa-performance-features--{{ section.id }} .wa-performance-features__icon {
    --wa-brand-icon-size: 3rem;
    width: 3rem;
    height: 3rem;
    color: currentColor;
    opacity: 0.92;
  }

  .wa-performance-features--{{ section.id }} .wa-performance-features__icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .wa-performance-features--{{ section.id }} .wa-performance-features__title {
    margin: 0;
    white-space: nowrap;
    font-size: var(--wa-text-sm);
    font-weight: var(--wa-weight-semibold);
    letter-spacing: var(--wa-tracking-wider);
    line-height: var(--wa-leading-snug);
    text-transform: uppercase;
    color: var(--wa-color-evergreen);
  }

  @media screen and (min-width: 750px) {
    .wa-performance-features--{{ section.id }} .wa-performance-features__editorial {
      justify-content: flex-start;
      min-height: 64rem;
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      padding-left: clamp(5.6rem, 8vw, 12.8rem);
      padding-right: 50%;
      text-align: left;
    }

    .wa-performance-features--{{ section.id }} .wa-performance-features__content {
      width: min(100%, 52rem);
      margin: 0;
      text-align: left;
    }

    .wa-performance-features--{{ section.id }} .wa-performance-features__overlay {
      background:
        linear-gradient(90deg, rgba(0, 0, 0, 0.72) 0%, rgba(0, 0, 0, 0.52) 32%, rgba(0, 0, 0, 0.18) 62%, rgba(0, 0, 0, 0.08) 100%),
        var(--wa-color-black);
    }

    .wa-performance-features--{{ section.id }} .wa-performance-features__heading {
      margin-left: 0;
      margin-right: 0;
      font-size: clamp(4.8rem, 6vw, calc(var(--font-heading-scale) * 7.2rem));
      line-height: 0.95;
    }

    .wa-performance-features--{{ section.id }} .wa-performance-features__subheading {
      margin-left: 0;
      margin-right: 0;
      font-size: var(--wa-text-lg);
    }

    .wa-performance-features--{{ section.id }} .wa-performance-features__strip-inner {
      padding: 0 5rem;
    }

  }

  @media screen and (min-width: 990px) {
    .wa-performance-features--{{ section.id }} .wa-performance-features__editorial {
      padding-left: clamp(7.2rem, 8vw, 15.2rem);
      padding-right: 54%;
    }

    .wa-performance-features--{{ section.id }} .wa-performance-features__strip-inner {
      padding: 0 6rem;
    }
  }

  @media screen and (min-width: 1400px) {
    .wa-performance-features--{{ section.id }} .wa-performance-features__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-columns: auto;
      grid-auto-flow: row;
      gap: 2.4rem;
      overflow-x: visible;
    }
  }

  @media screen and (max-width: 749px) {
    .wa-performance-features--{{ section.id }} .wa-performance-features__editorial {
      min-height: 42rem;
      padding-top: {{ section.settings.padding_top | times: 0.4167 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.4167 | round: 0 }}px;
    }

    .wa-performance-features--{{ section.id }} .wa-performance-features__content {
      padding: 1.6rem 0;
    }

    .wa-performance-features--{{ section.id }} .wa-performance-features__content::before {
      margin-bottom: 1.2rem;
    }

    .wa-performance-features--{{ section.id }} .wa-performance-features__heading {
      font-size: clamp(3.4rem, 10vw, 4.8rem);
      line-height: 0.98;
    }

    .wa-performance-features--{{ section.id }} .wa-performance-features__subheading {
      margin-top: 1.6rem;
      font-size: var(--wa-text-sm);
      line-height: var(--wa-leading-normal);
    }

    .wa-performance-features--{{ section.id }} .wa-performance-features__cta {
      min-height: 4.4rem;
      margin-top: 2rem;
      padding: 1.1rem 1.8rem;
    }

    .wa-performance-features--{{ section.id }} .wa-performance-features__strip {
      padding: 2.2rem 0;
    }

    .wa-performance-features--{{ section.id }} .wa-performance-features__list {
      gap: 2rem;
      scroll-snap-type: x proximity;
    }

    .wa-performance-features--{{ section.id }} .wa-performance-features__item {
      scroll-snap-align: start;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .wa-performance-features--{{ section.id }} .wa-performance-features__cta:hover {
      border-color: var(--wa-color-parchment);
      background-color: var(--wa-color-parchment);
      color: var(--wa-color-evergreen);
    }
  }

  .wa-performance-features--{{ section.id }} .wa-performance-features__cta:focus-visible {
    outline: 0.2rem solid var(--wa-color-parchment);
    outline-offset: 0.3rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-performance-features--{{ section.id }} .wa-performance-features__cta {
      transition: none;
    }
  }
{%- endstyle -%}

<div class="wa-performance-features wa-performance-features--{{ section.id }}">
  <div class="wa-performance-features__editorial">
    <div class="wa-performance-features__media" aria-hidden="true">
      {%- if section.settings.background_image != blank -%}
        {{
          section.settings.background_image
          | image_url: width: 3000
          | image_tag:
            class: 'wa-performance-features__image',
            widths: '750, 1100, 1500, 2000, 2400, 3000',
            sizes: '100vw',
            loading: 'lazy'
        }}
      {%- else -%}
        {{ 'hero-apparel-3' | placeholder_svg_tag: 'wa-performance-features__placeholder placeholder-svg' }}
      {%- endif -%}
    </div>
    <div class="wa-performance-features__overlay" aria-hidden="true"></div>

    <div class="wa-performance-features__content">
      <h2 class="wa-performance-features__heading">
        {{ section.settings.heading | escape | newline_to_br }}
      </h2>
      {%- if section.settings.subheading != blank -%}
        <p class="wa-performance-features__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
      {%- if section.settings.cta_text != blank -%}
        <a
          class="wa-performance-features__cta"
          {% if section.settings.cta_link == blank %}
            role="link"
            aria-disabled="true"
          {% else %}
            href="{{ section.settings.cta_link }}"
          {% endif %}
        >
          {{ section.settings.cta_text | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>

  <div class="wa-performance-features__strip">
    <div class="wa-performance-features__strip-inner">
      <ul class="wa-performance-features__list" role="list">
        {%- if section.settings.enable_feature_1 -%}
          <li class="wa-performance-features__item">
            {% render 'wa-brand-icon', icon: 'moisture', class: 'wa-performance-features__icon' %}
            <h3 class="wa-performance-features__title">{{ section.settings.feature_1_title | escape }}</h3>
          </li>
        {%- endif -%}

        {%- if section.settings.enable_feature_2 -%}
          <li class="wa-performance-features__item">
            {% render 'wa-brand-icon', icon: 'stretch', class: 'wa-performance-features__icon' %}
            <h3 class="wa-performance-features__title">{{ section.settings.feature_2_title | escape }}</h3>
          </li>
        {%- endif -%}

        {%- if section.settings.enable_feature_3 -%}
          <li class="wa-performance-features__item">
            {% render 'wa-brand-icon', icon: 'breathable', class: 'wa-performance-features__icon' %}
            <h3 class="wa-performance-features__title">{{ section.settings.feature_3_title | escape }}</h3>
          </li>
        {%- endif -%}

        {%- if section.settings.enable_feature_4 -%}
          <li class="wa-performance-features__item">
            {% render 'wa-brand-icon', icon: 'shirt', class: 'wa-performance-features__icon' %}
            <h3 class="wa-performance-features__title">{{ section.settings.feature_4_title | escape }}</h3>
          </li>
        {%- endif -%}
      </ul>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "WA Performance Features",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "BUILT FOR EVERY REP.\nDESIGNED FOR EVERY DAY."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Premium activewear engineered for movement, training and everyday performance."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Shop Collection →"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 45
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 40,
      "max": 180,
      "step": 4,
      "unit": "px",
      "label": "Editorial top padding",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 40,
      "max": 180,
      "step": 4,
      "unit": "px",
      "label": "Editorial bottom padding",
      "default": 120
    },
    {
      "type": "header",
      "content": "Feature 1"
    },
    {
      "type": "checkbox",
      "id": "enable_feature_1",
      "label": "Enable feature 1",
      "default": true
    },
    {
      "type": "text",
      "id": "feature_1_title",
      "label": "Title",
      "default": "Moisture-Wicking"
    },
    {
      "type": "header",
      "content": "Feature 2"
    },
    {
      "type": "checkbox",
      "id": "enable_feature_2",
      "label": "Enable feature 2",
      "default": true
    },
    {
      "type": "text",
      "id": "feature_2_title",
      "label": "Title",
      "default": "4-Way Stretch"
    },
    {
      "type": "header",
      "content": "Feature 3"
    },
    {
      "type": "checkbox",
      "id": "enable_feature_3",
      "label": "Enable feature 3",
      "default": true
    },
    {
      "type": "text",
      "id": "feature_3_title",
      "label": "Title",
      "default": "Breathable Fabric"
    },
    {
      "type": "header",
      "content": "Feature 4"
    },
    {
      "type": "checkbox",
      "id": "enable_feature_4",
      "label": "Enable feature 4",
      "default": true
    },
    {
      "type": "text",
      "id": "feature_4_title",
      "label": "Title",
      "default": "Everyday Comfort"
    }
  ],
  "presets": [
    {
      "name": "WA Performance Features"
    }
  ]
}
{% endschema %}
