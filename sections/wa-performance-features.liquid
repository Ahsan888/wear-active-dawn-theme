{% comment %}
  Wear Active custom code start — wa-performance-features.liquid
  Premium homepage editorial performance section.
{% endcomment %}

{%- style -%}
  .wa-performance-features--{{ section.id }}.wa-performance-features {
    background-color: #ffffff;
    color: #111111;
  }

  .wa-performance-features--{{ section.id }} .wa-performance-features__editorial {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 48rem;
    padding-top: {{ section.settings.padding_top | times: 0.6667 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.6667 | round: 0 }}px;
    overflow: hidden;
    background-color: #1a1a1a;
    color: #ffffff;
    text-align: center;
  }

  .wa-performance-features--{{ section.id }} .wa-performance-features__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .wa-performance-features--{{ section.id }} .wa-performance-features__image,
  .wa-performance-features--{{ section.id }} .wa-performance-features__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .wa-performance-features--{{ section.id }} .wa-performance-features__placeholder {
    background-color: #2a2a2a;
    opacity: 0.9;
  }

  .wa-performance-features--{{ section.id }} .wa-performance-features__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: #000000;
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }

  .wa-performance-features--{{ section.id }} .wa-performance-features__content {
    width: min(100% - 4rem, 82rem);
    margin: 0 auto;
  }

  .wa-performance-features--{{ section.id }} .wa-performance-features__heading {
    max-width: 78rem;
    margin: 0 auto;
    font-size: clamp(3.6rem, 8vw, calc(var(--font-heading-scale) * 7.2rem));
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 0.98;
    text-transform: uppercase;
    color: inherit;
  }

  .wa-performance-features--{{ section.id }} .wa-performance-features__subheading {
    max-width: 65rem;
    margin: 2.4rem auto 0;
    font-size: var(--wa-text-md);
    font-weight: var(--wa-weight-regular);
    letter-spacing: var(--wa-tracking-normal);
    line-height: var(--wa-leading-relaxed);
    color: rgba(255, 255, 255, 0.82);
  }

  .wa-performance-features--{{ section.id }} .wa-performance-features__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 4.8rem;
    margin-top: 3.2rem;
    padding: 1.3rem 2.4rem;
    border: 0.1rem solid rgba(255, 255, 255, 0.86);
    color: #ffffff;
    background-color: transparent;
    font-size: var(--wa-text-sm);
    font-weight: var(--wa-weight-medium);
    letter-spacing: var(--wa-tracking-wide);
    line-height: var(--wa-leading-snug);
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 200ms ease, border-color 200ms ease, color 200ms ease;
  }

  .wa-performance-features--{{ section.id }} .wa-performance-features__cta[aria-disabled='true'] {
    cursor: default;
  }

  .wa-performance-features--{{ section.id }} .wa-performance-features__strip {
    padding: 5.6rem 0;
    background-color: #ffffff;
    border-top: 0.1rem solid rgba(0, 0, 0, 0.06);
    border-bottom: 0.1rem solid rgba(0, 0, 0, 0.06);
  }

  .wa-performance-features--{{ section.id }} .wa-performance-features__strip-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .wa-performance-features--{{ section.id }} .wa-performance-features__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3.2rem 2.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .wa-performance-features--{{ section.id }} .wa-performance-features__item {
    min-width: 0;
    text-align: center;
  }

  .wa-performance-features--{{ section.id }} .wa-performance-features__icon {
    display: block;
    width: 3rem;
    height: 3rem;
    margin: 0 auto 1.8rem;
    color: currentColor;
    opacity: 0.92;
  }

  .wa-performance-features--{{ section.id }} .wa-performance-features__icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .wa-performance-features--{{ section.id }} .wa-performance-features__title {
    margin: 0 0 0.9rem;
    font-size: var(--wa-text-sm);
    font-weight: var(--wa-weight-semibold);
    letter-spacing: var(--wa-tracking-wider);
    line-height: var(--wa-leading-snug);
    text-transform: uppercase;
    color: #111111;
  }

  .wa-performance-features--{{ section.id }} .wa-performance-features__description {
    max-width: 24rem;
    margin: 0 auto;
    font-size: var(--wa-text-sm);
    font-weight: var(--wa-weight-regular);
    letter-spacing: var(--wa-tracking-normal);
    line-height: var(--wa-leading-relaxed);
    color: rgba(17, 17, 17, 0.7);
  }

  @media screen and (min-width: 750px) {
    .wa-performance-features--{{ section.id }} .wa-performance-features__editorial {
      min-height: 64rem;
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    .wa-performance-features--{{ section.id }} .wa-performance-features__content {
      width: min(100% - 10rem, 82rem);
    }

    .wa-performance-features--{{ section.id }} .wa-performance-features__subheading {
      font-size: var(--wa-text-lg);
    }

    .wa-performance-features--{{ section.id }} .wa-performance-features__strip-inner {
      padding: 0 5rem;
    }

    .wa-performance-features--{{ section.id }} .wa-performance-features__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 3.2rem;
    }
  }

  @media screen and (min-width: 990px) {
    .wa-performance-features--{{ section.id }} .wa-performance-features__strip-inner {
      padding: 0 6rem;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .wa-performance-features--{{ section.id }} .wa-performance-features__cta:hover {
      border-color: #ffffff;
      background-color: #ffffff;
      color: #111111;
    }
  }

  .wa-performance-features--{{ section.id }} .wa-performance-features__cta:focus-visible {
    outline: 0.2rem solid #ffffff;
    outline-offset: 0.3rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-performance-features--{{ section.id }} .wa-performance-features__cta {
      transition: none;
    }
  }
{%- endstyle -%}

<div class="wa-performance-features wa-performance-features--{{ section.id }}">
  <div class="wa-performance-features__editorial">
    <div class="wa-performance-features__media" aria-hidden="true">
      {%- if section.settings.background_image != blank -%}
        {{
          section.settings.background_image
          | image_url: width: 3000
          | image_tag:
            class: 'wa-performance-features__image',
            widths: '750, 1100, 1500, 2000, 2400, 3000',
            sizes: '100vw',
            loading: 'lazy'
        }}
      {%- else -%}
        {{ 'hero-apparel-3' | placeholder_svg_tag: 'wa-performance-features__placeholder placeholder-svg' }}
      {%- endif -%}
    </div>
    <div class="wa-performance-features__overlay" aria-hidden="true"></div>

    <div class="wa-performance-features__content">
      <h2 class="wa-performance-features__heading">
        {{ section.settings.heading | escape | newline_to_br }}
      </h2>
      {%- if section.settings.subheading != blank -%}
        <p class="wa-performance-features__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
      {%- if section.settings.cta_text != blank -%}
        <a
          class="wa-performance-features__cta"
          {% if section.settings.cta_link == blank %}
            role="link"
            aria-disabled="true"
          {% else %}
            href="{{ section.settings.cta_link }}"
          {% endif %}
        >
          {{ section.settings.cta_text | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>

  <div class="wa-performance-features__strip">
    <div class="wa-performance-features__strip-inner">
      <ul class="wa-performance-features__list" role="list">
        {%- if section.settings.enable_feature_1 -%}
          <li class="wa-performance-features__item">
            <span class="wa-performance-features__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 28 28" fill="none" focusable="false">
                <path d="M4 16.5c4.2-3 7.8-3 12 0s7.8 3 12 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M4 21.5c4.2-3 7.8-3 12 0s7.8 3 12 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M13.5 4.5c-2.2 2.7-3.4 4.8-3.4 6.4a3.9 3.9 0 0 0 7.8 0c0-1.6-1.2-3.7-3.4-6.4a.7.7 0 0 0-1 0Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
              </svg>
            </span>
            <h3 class="wa-performance-features__title">{{ section.settings.feature_1_title | escape }}</h3>
            <p class="wa-performance-features__description">{{ section.settings.feature_1_description | escape }}</p>
          </li>
        {%- endif -%}

        {%- if section.settings.enable_feature_2 -%}
          <li class="wa-performance-features__item">
            <span class="wa-performance-features__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 28 28" fill="none" focusable="false">
                <path d="M7.5 14h13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="m11 9-5 5 5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="m17 9 5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M14 6.5v15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="1.5 4"/>
              </svg>
            </span>
            <h3 class="wa-performance-features__title">{{ section.settings.feature_2_title | escape }}</h3>
            <p class="wa-performance-features__description">{{ section.settings.feature_2_description | escape }}</p>
          </li>
        {%- endif -%}

        {%- if section.settings.enable_feature_3 -%}
          <li class="wa-performance-features__item">
            <span class="wa-performance-features__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 28 28" fill="none" focusable="false">
                <path d="M4 10h12.6a3.2 3.2 0 1 0-3.2-3.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M4 15h17.8a3.2 3.2 0 1 1-3.2 3.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M4 20h8.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </span>
            <h3 class="wa-performance-features__title">{{ section.settings.feature_3_title | escape }}</h3>
            <p class="wa-performance-features__description">{{ section.settings.feature_3_description | escape }}</p>
          </li>
        {%- endif -%}

        {%- if section.settings.enable_feature_4 -%}
          <li class="wa-performance-features__item">
            <span class="wa-performance-features__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 28 28" fill="none" focusable="false">
                <path d="M14 24a10 10 0 1 0-10-10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M14 8v6l4 2.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M4 14h3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M14 4v3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M24 14h-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </span>
            <h3 class="wa-performance-features__title">{{ section.settings.feature_4_title | escape }}</h3>
            <p class="wa-performance-features__description">{{ section.settings.feature_4_description | escape }}</p>
          </li>
        {%- endif -%}
      </ul>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "WA Performance Features",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "BUILT FOR EVERY REP.\nDESIGNED FOR EVERY DAY."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Premium activewear engineered for movement, training and everyday performance."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Shop Collection →"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 45
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 40,
      "max": 180,
      "step": 4,
      "unit": "px",
      "label": "Editorial top padding",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 40,
      "max": 180,
      "step": 4,
      "unit": "px",
      "label": "Editorial bottom padding",
      "default": 120
    },
    {
      "type": "header",
      "content": "Feature 1"
    },
    {
      "type": "checkbox",
      "id": "enable_feature_1",
      "label": "Enable feature 1",
      "default": true
    },
    {
      "type": "text",
      "id": "feature_1_title",
      "label": "Title",
      "default": "Moisture-Wicking"
    },
    {
      "type": "text",
      "id": "feature_1_description",
      "label": "Description",
      "default": "Keeps you dry during training and daily movement."
    },
    {
      "type": "header",
      "content": "Feature 2"
    },
    {
      "type": "checkbox",
      "id": "enable_feature_2",
      "label": "Enable feature 2",
      "default": true
    },
    {
      "type": "text",
      "id": "feature_2_title",
      "label": "Title",
      "default": "4-Way Stretch"
    },
    {
      "type": "text",
      "id": "feature_2_description",
      "label": "Description",
      "default": "Moves naturally with your body without restriction."
    },
    {
      "type": "header",
      "content": "Feature 3"
    },
    {
      "type": "checkbox",
      "id": "enable_feature_3",
      "label": "Enable feature 3",
      "default": true
    },
    {
      "type": "text",
      "id": "feature_3_title",
      "label": "Title",
      "default": "Breathable Fabric"
    },
    {
      "type": "text",
      "id": "feature_3_description",
      "label": "Description",
      "default": "Designed to maximize airflow and lasting comfort."
    },
    {
      "type": "header",
      "content": "Feature 4"
    },
    {
      "type": "checkbox",
      "id": "enable_feature_4",
      "label": "Enable feature 4",
      "default": true
    },
    {
      "type": "text",
      "id": "feature_4_title",
      "label": "Title",
      "default": "Everyday Comfort"
    },
    {
      "type": "text",
      "id": "feature_4_description",
      "label": "Description",
      "default": "Made for the gym, work, travel, and everything in between."
    }
  ],
  "presets": [
    {
      "name": "WA Performance Features"
    }
  ]
}
{% endschema %}
