{% comment %}
  Wear Active custom code start — wa-shop-by-category.liquid
  Premium homepage Shop by Category section.
{% endcomment %}

{{ 'wa-shop-by-category.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #WaShopByCategory-{{ section.id }} .wa-shop-by-category__card {
    border-radius: {{ section.settings.image_radius }}px;
  }

  #WaShopByCategory-{{ section.id }} .wa-shop-by-category__media {
    aspect-ratio: {{ section.settings.mobile_card_ratio }};
  }

  @media screen and (min-width: 750px) {
    #WaShopByCategory-{{ section.id }} .wa-shop-by-category__media {
      aspect-ratio: {{ section.settings.desktop_card_ratio }};
    }
  }
{%- endstyle -%}

<section
  id="WaShopByCategory-{{ section.id }}"
  class="wa-shop-by-category wa-shop-by-category--{{ section.settings.layout_style }} color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
>
  <div class="wa-shop-by-category__inner">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subheading != blank -%}
      <header class="wa-shop-by-category__header">
        <div class="wa-shop-by-category__heading-group">
          {%- if section.settings.eyebrow != blank -%}
            <p class="wa-shop-by-category__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="wa-shop-by-category__heading">
              {{ section.settings.heading | escape }}
            </h2>
          {%- endif -%}
        </div>
        {%- if section.settings.subheading != blank -%}
          <p class="wa-shop-by-category__subheading">
            {{ section.settings.subheading | escape }}
          </p>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="wa-shop-by-category__grid" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign wa_category_title = block.settings.title
            if wa_category_title == blank and block.settings.collection != blank
              assign wa_category_title = block.settings.collection.title
            endif

            assign wa_category_link = block.settings.collection.url
            if wa_category_link == blank
              assign wa_category_link = block.settings.link
            endif

            assign wa_category_cta = block.settings.cta_text
            if wa_category_cta == blank
              assign wa_category_cta = 'Shop Now'
            endif

            assign wa_category_image = block.settings.image
            if wa_category_image == blank and block.settings.collection != blank and block.settings.collection.image != blank
              assign wa_category_image = block.settings.collection.image
            endif

            assign wa_category_alt = wa_category_image.alt | default: wa_category_title | escape
            assign wa_card_label = wa_category_title | append: ' — ' | append: wa_category_cta

            assign wa_lazy_load = true
            if section.settings.layout_style == 'editorial' and forloop.index <= 3
              assign wa_lazy_load = false
            endif

            if wa_lazy_load
              assign wa_loading = 'lazy'
            else
              assign wa_loading = 'eager'
            endif
          -%}

          <li class="wa-shop-by-category__item" {{ block.shopify_attributes }}>
            {%- if wa_category_link != blank -%}
              <a
                class="wa-shop-by-category__card"
                href="{{ wa_category_link }}"
                aria-label="{{ wa_card_label | escape }}"
              >
            {%- else -%}
              <div class="wa-shop-by-category__card" role="group" aria-label="{{ wa_category_title | escape }}">
            {%- endif -%}
                <div class="wa-shop-by-category__media">
                  {%- if wa_category_image != blank -%}
                    {%- capture wa_category_sizes -%}
                      (min-width: 990px) calc((min(100vw, 144rem) - 12rem) / 3),
                      (min-width: 750px) calc((100vw - 10rem) / 3),
                      calc((100vw - 4rem) / 2)
                    {%- endcapture -%}
                    {{
                      wa_category_image
                      | image_url: width: 1500
                      | image_tag:
                        class: 'wa-shop-by-category__image',
                        loading: wa_loading,
                        widths: '375, 550, 750, 1100, 1500',
                        sizes: wa_category_sizes,
                        width: wa_category_image.width,
                        height: wa_category_image.height,
                        alt: wa_category_alt
                    }}
                  {%- else -%}
                    {{ 'collection-1' | placeholder_svg_tag: 'wa-shop-by-category__placeholder' }}
                  {%- endif -%}
                  {%- if block.settings.icon != blank and block.settings.icon != 'none' -%}
                    <span class="wa-shop-by-category__icon-badge">
                      {% render 'wa-brand-icon', icon: block.settings.icon, class: 'wa-shop-by-category__brand-icon' %}
                    </span>
                  {%- endif -%}
                  <span class="wa-shop-by-category__overlay" aria-hidden="true"></span>
                </div>

                <div class="wa-shop-by-category__content">
                  {%- if wa_category_title != blank -%}
                    <h3 class="wa-shop-by-category__title">
                      {{ wa_category_title | escape }}
                    </h3>
                  {%- endif -%}
                  <span class="wa-shop-by-category__cta">
                    {{ wa_category_cta | escape }}
                    <span class="wa-shop-by-category__cta-arrow" aria-hidden="true">→</span>
                  </span>
                </div>
            {%- if wa_category_link != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "WA Shop by Category",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "options": [
        {
          "value": "editorial",
          "label": "Editorial"
        },
        {
          "value": "compact",
          "label": "Compact category grid"
        }
      ],
      "default": "editorial"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Card corner radius",
      "default": 0
    },
    {
      "type": "select",
      "id": "desktop_card_ratio",
      "label": "Desktop card shape",
      "options": [
        {
          "value": "16 / 9",
          "label": "Wide (16:9)"
        },
        {
          "value": "4 / 3",
          "label": "Landscape (4:3)"
        },
        {
          "value": "1 / 1",
          "label": "Square (1:1)"
        },
        {
          "value": "4 / 5",
          "label": "Portrait (4:5)"
        },
        {
          "value": "2 / 3",
          "label": "Tall portrait (2:3)"
        }
      ],
      "default": "4 / 3"
    },
    {
      "type": "select",
      "id": "mobile_card_ratio",
      "label": "Mobile card shape",
      "options": [
        {
          "value": "4 / 3",
          "label": "Landscape (4:3)"
        },
        {
          "value": "1 / 1",
          "label": "Square (1:1)"
        },
        {
          "value": "4 / 5",
          "label": "Portrait (4:5)"
        },
        {
          "value": "2 / 3",
          "label": "Tall portrait (2:3)"
        }
      ],
      "default": "4 / 5"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category image"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Brand icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "shirt", "label": "Shirt" },
            { "value": "polo", "label": "Polo" },
            { "value": "tank", "label": "Tank" },
            { "value": "trousers", "label": "Trousers" },
            { "value": "shorts", "label": "Shorts" },
            { "value": "hoodie", "label": "Hoodie" },
            { "value": "jacket", "label": "Jacket" },
            { "value": "womens", "label": "Women's activewear" },
            { "value": "hanger", "label": "Hanger" },
            { "value": "breathable", "label": "Breathable" }
          ],
          "default": "none"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category title",
          "default": "Category"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link",
          "info": "Used only if no collection is selected."
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "CTA text",
          "default": "Shop Now"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "WA Shop by Category",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "icon": "shirt",
            "title": "Shirts"
          }
        },
        {
          "type": "category",
          "settings": {
            "icon": "trousers",
            "title": "Trousers"
          }
        },
        {
          "type": "category",
          "settings": {
            "icon": "womens",
            "title": "Women's"
          }
        },
        {
          "type": "category",
          "settings": {
            "icon": "shorts",
            "title": "Shorts"
          }
        },
        {
          "type": "category",
          "settings": {
            "icon": "hoodie",
            "title": "Hoodies"
          }
        },
        {
          "type": "category",
          "settings": {
            "icon": "jacket",
            "title": "Jackets"
          }
        }
      ]
    }
  ]
}
{% endschema %}
