{{ 'wa-hero-carousel.css' | asset_url | stylesheet_tag }}
<script src="{{ 'wa-hero-carousel.js' | asset_url }}" defer="defer"></script>

<wa-hero-carousel
  class="wa-hero-carousel color-{{ section.settings.color_scheme }} gradient"
  data-autoplay="{{ section.settings.auto_rotate }}"
  data-delay="{{ section.settings.change_slides_speed }}"
  role="region"
  aria-roledescription="carousel"
  aria-label="{{ section.settings.accessibility_label | escape }}"
>
  <div class="wa-hero-carousel__viewport">
    <div class="wa-hero-carousel__track" data-wa-carousel-track>
      {%- for block in section.blocks -%}
        {%- liquid
          assign desktop_asset = blank
          assign mobile_asset = blank

          case block.settings.default_artwork
            when 'hero_1'
              assign desktop_asset = 'wa-home-hero-01.webp'
              assign mobile_asset = 'wa-home-hero-01-mobile.webp'
            when 'hero_2'
              assign desktop_asset = 'wa-home-hero-02.webp'
              assign mobile_asset = 'wa-home-hero-02-mobile.webp'
          endcase

          assign image_alt = block.settings.alt_text
          if image_alt == blank and block.settings.image.alt != blank
            assign image_alt = block.settings.image.alt
          endif

          if forloop.first
            assign loading_strategy = 'eager'
            assign fetch_priority = 'high'
          else
            assign loading_strategy = 'lazy'
            assign fetch_priority = 'auto'
          endif
        -%}
        <div
          class="wa-hero-carousel__slide"
          data-wa-carousel-slide
          role="group"
          aria-roledescription="slide"
          aria-label="{{ forloop.index }} of {{ forloop.length }}"
          aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.link != blank -%}
            <a class="wa-hero-carousel__link" href="{{ block.settings.link }}">
          {%- endif -%}

          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 2400
              | image_tag:
                class: 'wa-hero-carousel__image',
                widths: '480, 750, 960, 1280, 1600, 2048, 2400',
                sizes: '100vw',
                loading: loading_strategy,
                fetchpriority: fetch_priority,
                alt: image_alt
            }}
          {%- elsif desktop_asset != blank -%}
            <picture class="wa-hero-carousel__picture">
              <source media="(max-width: 749px)" srcset="{{ mobile_asset | asset_url }}">
              <img
                class="wa-hero-carousel__image"
                src="{{ desktop_asset | asset_url }}"
                width="2048"
                height="1152"
                alt="{{ image_alt | escape }}"
                loading="{{ loading_strategy }}"
                fetchpriority="{{ fetch_priority }}"
              >
            </picture>
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'wa-hero-carousel__image placeholder-svg' }}
          {%- endif -%}

          {%- if block.settings.link != blank -%}
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>

  {%- if section.blocks.size > 1 -%}
    {%- if section.settings.show_arrows -%}
      <button
        class="wa-hero-carousel__control wa-hero-carousel__control--previous"
        type="button"
        aria-label="Previous slide"
        data-wa-carousel-previous
      >
        <span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span>
      </button>
      <button
        class="wa-hero-carousel__control wa-hero-carousel__control--next"
        type="button"
        aria-label="Next slide"
        data-wa-carousel-next
      >
        <span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span>
      </button>
    {%- endif -%}

    <div class="wa-hero-carousel__footer">
      {%- if section.settings.show_dots -%}
        <div class="wa-hero-carousel__dots" role="group" aria-label="Choose a slide">
          {%- for block in section.blocks -%}
            <button
              class="wa-hero-carousel__dot"
              type="button"
              aria-label="Show slide {{ forloop.index }}"
              aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
              data-wa-carousel-dot
            ></button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.auto_rotate -%}
        <button
          class="wa-hero-carousel__pause"
          type="button"
          aria-label="Pause slideshow"
          aria-pressed="false"
          data-wa-carousel-pause
        >
          <span class="svg-wrapper icon-pause">{{ 'icon-pause.svg' | inline_asset_content }}</span>
          <span class="svg-wrapper icon-play">{{ 'icon-play.svg' | inline_asset_content }}</span>
        </button>
      {%- endif -%}
    </div>
  {%- endif -%}
</wa-hero-carousel>

{% schema %}
{
  "name": "WA hero carousel",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Wear Active featured campaigns"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 9,
      "step": 1,
      "unit": "s",
      "label": "Change slides every",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show slide indicators",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "limit": 5,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image"
        },
        {
          "type": "select",
          "id": "default_artwork",
          "label": "Included artwork",
          "info": "Used when no custom image is selected.",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "hero_1",
              "label": "Summer Essentials 26"
            },
            {
              "value": "hero_2",
              "label": "Shop the Look SE26"
            }
          ],
          "default": "none"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Image alt text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "WA hero carousel",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "default_artwork": "hero_2",
            "alt_text": "Wear Active red polo styled for racket sports"
          }
        },
        {
          "type": "slide",
          "settings": {
            "default_artwork": "hero_1",
            "alt_text": "Wear Active Summer Essentials 26 campaign"
          }
        }
      ]
    }
  ]
}
{% endschema %}
