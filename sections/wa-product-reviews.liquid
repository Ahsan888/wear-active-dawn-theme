{% comment %}
  Wear Active custom code start — wa-product-reviews.liquid
  Product page reviews section with family-aggregated Judge.me widget support.
{% endcomment %}

{{ 'wa-product-reviews.css' | asset_url | stylesheet_tag }}
{{ 'component-rating.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section
  id="wa-product-reviews"
  class="wa-product-reviews section section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient"
>
  {% render 'wa-product-family-reviews-data', product: product, format: 'json' %}
  {% render 'wa-product-reviews-boot', product: product %}

  <div class="page-width wa-product-reviews__inner{% if section.settings.include_margins == false %} wa-product-reviews__inner--full{% endif %}">
    {%- if section.settings.heading != blank -%}
      <header class="wa-product-reviews__header">
        <h2 class="wa-product-reviews__heading inline-richtext {{ section.settings.heading_size }}">
          {{ section.settings.heading }}
        </h2>
      </header>
    {%- endif -%}

    <div class="wa-product-reviews__widget" data-wa-product-reviews-widget>
      {% render 'wa-product-family-reviews-data', product: product, format: 'widget-summary' %}
      {%- for block in section.blocks -%}
        {% render block %}
      {%- endfor -%}
    </div>
  </div>
</section>

<script src="{{ 'wa-product-reviews.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Product reviews",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Customer reviews"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "checkbox",
      "id": "include_margins",
      "default": true,
      "label": "Use page width margins"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Product reviews"
    }
  ]
}
{% endschema %}
