{{ 'wa-lifestyle-gallery.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .wa-lifestyle-gallery--{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
  }

  @media screen and (min-width: 750px) {
    .wa-lifestyle-gallery--{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="wa-lifestyle-gallery wa-lifestyle-gallery--{{ section.id }}">
  <div class="wa-lifestyle-gallery__inner">
    <header class="wa-lifestyle-gallery__header">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="wa-lifestyle-gallery__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="wa-lifestyle-gallery__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
      <div class="wa-lifestyle-gallery__copy">
        {%- if section.settings.text != blank -%}
          <p class="wa-lifestyle-gallery__text">{{ section.settings.text | escape }}</p>
        {%- endif -%}
        {%- if section.settings.cta_text != blank -%}
          <a
            class="wa-lifestyle-gallery__cta"
            {% if section.settings.cta_link != blank %}
              href="{{ section.settings.cta_link }}"
            {% else %}
              role="link" aria-disabled="true"
            {% endif %}
          >
            {{ section.settings.cta_text | escape }}
          </a>
        {%- endif -%}
      </div>
    </header>

    <div class="wa-lifestyle-gallery__portraits" aria-label="Wear Active Summer Essentials campaign photography">
      <div class="wa-lifestyle-gallery__portrait">
        {%- if section.settings.portrait_1 != blank -%}
          {{
            section.settings.portrait_1
            | image_url: width: 1500
            | image_tag:
              class: 'wa-lifestyle-gallery__image',
              widths: '375, 550, 720, 960, 1200, 1500',
              sizes: '(min-width: 750px) 32vw, 80vw',
              loading: 'lazy',
              alt: section.settings.portrait_1_alt
          }}
        {%- else -%}
          <picture class="wa-lifestyle-gallery__picture">
            <source media="(max-width: 749px)" srcset="{{ 'wa-lifestyle-01087-mobile.webp' | asset_url }}">
            <img class="wa-lifestyle-gallery__image" src="{{ 'wa-lifestyle-01087.webp' | asset_url }}" width="1200" height="1801" loading="lazy" alt="{{ section.settings.portrait_1_alt | escape }}">
          </picture>
        {%- endif -%}
      </div>

      <div class="wa-lifestyle-gallery__portrait">
        {%- if section.settings.portrait_2 != blank -%}
          {{
            section.settings.portrait_2
            | image_url: width: 1500
            | image_tag:
              class: 'wa-lifestyle-gallery__image',
              widths: '375, 550, 720, 960, 1200, 1500',
              sizes: '(min-width: 750px) 32vw, 80vw',
              loading: 'lazy',
              alt: section.settings.portrait_2_alt
          }}
        {%- else -%}
          <picture class="wa-lifestyle-gallery__picture">
            <source media="(max-width: 749px)" srcset="{{ 'wa-lifestyle-01080-mobile.webp' | asset_url }}">
            <img class="wa-lifestyle-gallery__image" src="{{ 'wa-lifestyle-01080.webp' | asset_url }}" width="1200" height="1800" loading="lazy" alt="{{ section.settings.portrait_2_alt | escape }}">
          </picture>
        {%- endif -%}
      </div>

      <div class="wa-lifestyle-gallery__portrait">
        {%- if section.settings.portrait_3 != blank -%}
          {{
            section.settings.portrait_3
            | image_url: width: 1500
            | image_tag:
              class: 'wa-lifestyle-gallery__image',
              widths: '375, 550, 720, 960, 1200, 1500',
              sizes: '(min-width: 750px) 32vw, 80vw',
              loading: 'lazy',
              alt: section.settings.portrait_3_alt
          }}
        {%- else -%}
          <picture class="wa-lifestyle-gallery__picture">
            <source media="(max-width: 749px)" srcset="{{ 'wa-lifestyle-01170-mobile.webp' | asset_url }}">
            <img class="wa-lifestyle-gallery__image" src="{{ 'wa-lifestyle-01170.webp' | asset_url }}" width="1200" height="1801" loading="lazy" alt="{{ section.settings.portrait_3_alt | escape }}">
          </picture>
        {%- endif -%}
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "WA lifestyle gallery",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE SUMMER EDIT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "On court. Off duty."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Performance pieces built for movement and styled for everything after."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button label",
      "default": "Shop the collection →"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Portrait one"
    },
    {
      "type": "image_picker",
      "id": "portrait_1",
      "label": "Custom image",
      "info": "The included red polo campaign portrait is used when blank."
    },
    {
      "type": "text",
      "id": "portrait_1_alt",
      "label": "Alt text",
      "default": "Wear Active athlete in a red performance polo"
    },
    {
      "type": "header",
      "content": "Portrait two"
    },
    {
      "type": "image_picker",
      "id": "portrait_2",
      "label": "Custom image",
      "info": "The included overhead red polo portrait is used when blank."
    },
    {
      "type": "text",
      "id": "portrait_2_alt",
      "label": "Alt text",
      "default": "Wear Active athlete in a red polo beside racket sports equipment"
    },
    {
      "type": "header",
      "content": "Portrait three"
    },
    {
      "type": "image_picker",
      "id": "portrait_3",
      "label": "Custom image",
      "info": "The included three-person campaign portrait is used when blank."
    },
    {
      "type": "text",
      "id": "portrait_3_alt",
      "label": "Alt text",
      "default": "Three Wear Active athletes in performance clothing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "WA lifestyle gallery"
    }
  ]
}
{% endschema %}
