{% comment %}
  Wear Active custom code start — wa-trust-strip.liquid
  Compact, factual reassurance immediately after the homepage hero.
{% endcomment %}

<section class="wa-trust-strip" aria-label="Wear Active service promises">
  <div class="page-width">
    <ul class="wa-trust-strip__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="wa-trust-strip__item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank and block.settings.icon != 'none' -%}
            {% render 'wa-brand-icon', icon: block.settings.icon, class: 'wa-trust-strip__icon' %}
          {%- endif -%}
          <span class="wa-trust-strip__title">
            {%- if block.settings.icon == 'hanger' -%}
              {% render 'wa-exchange-policy', mode: 'label' %}
            {%- else -%}
              {{ block.settings.title | escape }}
            {%- endif -%}
          </span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "WA trust strip",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Brand icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "globe", "label": "Globe" },
            { "value": "dispatch", "label": "Dispatch" },
            { "value": "hanger", "label": "Hanger" },
            { "value": "payment", "label": "Payment" },
            { "value": "phone", "label": "Phone" },
            { "value": "email", "label": "Email" },
            { "value": "breathable", "label": "Breathable" },
            { "value": "recycle", "label": "Recycle" }
          ],
          "default": "none"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Free Delivery"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "WA trust strip",
      "blocks": [
        {
          "type": "trust_item",
          "settings": {
            "icon": "globe",
            "title": "Free Delivery"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon": "dispatch",
            "title": "2–5 Working Days"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon": "hanger",
            "title": "7-Day Size Exchange"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon": "payment",
            "title": "COD · Bank · JazzCash"
          }
        }
      ]
    }
  ]
}
{% endschema %}
