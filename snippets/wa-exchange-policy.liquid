{% comment %}
  Wear Active custom code start — wa-exchange-policy.liquid
  Single source of truth for size-exchange wording across the theme.

  Accepts:
  - mode: {String} "label" or "compact" for abbreviated contexts; defaults to full policy copy.
{% endcomment %}

{%- liquid
  assign wa_exchange_days = settings.wa_exchange_window | split: ' ' | first
-%}

{%- if mode == 'label' -%}
  {{- wa_exchange_days -}}-Day Size Exchange
{%- elsif mode == 'compact' -%}
  {{- wa_exchange_days -}}-day size exchange · {{ settings.wa_exchange_fee | escape }} delivery fee
{%- else -%}
  Size exchanges are available within {{ settings.wa_exchange_window | escape }} of delivery, including discounted
  products. A {{ settings.wa_exchange_fee | escape }} exchange delivery fee applies. Items must be unused, unworn,
  unwashed, and have original tags attached. If Wear Active sends an incorrect or defective item, replacement delivery
  is free.
{%- endif -%}
