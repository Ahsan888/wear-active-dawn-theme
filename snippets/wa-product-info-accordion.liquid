{% comment %}
  Wear Active custom code start — wa-product-info-accordion.liquid
  Collapsible product information sections below the trust block.

  Accepts:
  - block: {Object} Theme editor block with section copy settings.
  - product: {Object} Product object.
  - section: {Object} Section object.
{% endcomment %}

{%- if block.settings.enable -%}
  {%- liquid
    capture wa_exchange_policy_url
      render 'wa-exchange-policy-url'
    endcapture
    assign wa_exchange_policy_url = wa_exchange_policy_url | strip

    assign wa_info_description_id = 'WaProductInfo-Description-' | append: section.id
    assign wa_info_service_id = 'WaProductInfo-Service-' | append: section.id
    assign wa_info_care_id = 'WaProductInfo-Care-' | append: section.id
    assign wa_info_description_content_id = 'WaProductInfo-Description-Content-' | append: section.id
    assign wa_info_service_content_id = 'WaProductInfo-Service-Content-' | append: section.id
    assign wa_info_care_content_id = 'WaProductInfo-Care-Content-' | append: section.id
  -%}

  <div class="wa-product-info quick-add-hidden" {{ block.shopify_attributes }}>
    {%- if product.description != blank -%}
      <div class="wa-product-info__accordion accordion product__accordion">
        <details id="{{ wa_info_description_id }}">
          <summary aria-controls="{{ wa_info_description_content_id }}">
            <div class="summary__title">
              <h2 class="h4 accordion__title">{{ block.settings.description_heading | escape }}</h2>
            </div>
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </summary>
          <div class="accordion__content rte" id="{{ wa_info_description_content_id }}">
            {{ product.description }}
          </div>
        </details>
      </div>
    {%- endif -%}

    <div class="wa-product-info__accordion accordion product__accordion">
      <details id="{{ wa_info_service_id }}">
        <summary aria-controls="{{ wa_info_service_content_id }}">
          <div class="summary__title">
            <h2 class="h4 accordion__title">{{ block.settings.service_heading | escape }}</h2>
          </div>
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </summary>
        <div class="accordion__content rte" id="{{ wa_info_service_content_id }}">
          <p>
            <strong>Delivery:</strong> Free across Pakistan in {{ settings.wa_delivery_window | escape }} via
            {{ settings.wa_couriers | escape }}. Tracking is shared on WhatsApp.
          </p>
          <p><strong>Size exchange:</strong> {% render 'wa-exchange-policy' %}</p>
          <p>
            <strong>Payment:</strong> {{ settings.wa_payment_methods | escape }}.
            {%- if settings.wa_cod_confirmation %} COD orders are confirmed on WhatsApp.{% endif -%}
          </p>
          <p class="wa-product-info__policy-links">
            {%- if shop.shipping_policy.body != blank -%}
              <a href="{{ shop.shipping_policy.url }}">Shipping policy</a>
            {%- endif -%}
            <a href="{{ wa_exchange_policy_url }}">Size exchange policy</a>
          </p>
        </div>
      </details>
    </div>

    {%- if block.settings.care_instructions != blank -%}
      <div class="wa-product-info__accordion accordion product__accordion">
        <details id="{{ wa_info_care_id }}">
          <summary aria-controls="{{ wa_info_care_content_id }}">
            <div class="summary__title">
              <h2 class="h4 accordion__title">{{ block.settings.care_heading | escape }}</h2>
            </div>
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </summary>
          <div class="accordion__content rte" id="{{ wa_info_care_content_id }}">
            <p>{{ block.settings.care_instructions | escape }}</p>
          </div>
        </details>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}
