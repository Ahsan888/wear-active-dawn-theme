{% comment %}
  Wear Active custom code start - wa-product-view-context.liquid
  Resolves PDP gallery context from Shopify request params first, then collection/path context.

  Outputs:
  - "women"
  - "men"
  - blank
{% endcomment %}

{%- liquid
  assign wa_view_context = request.params.view_context | default: '' | downcase

  if wa_view_context == blank and collection != blank
    capture wa_collection_context
      render 'wa-contextual-card-image', card_collection: collection
    endcapture
    assign wa_collection_context = wa_collection_context | strip

    if wa_collection_context == 'womens'
      assign wa_view_context = 'women'
    elsif wa_collection_context == 'mens'
      assign wa_view_context = 'men'
    endif
  endif

  if wa_view_context == blank
    assign wa_request_path = request.path | default: '' | downcase
    if wa_request_path contains '/collections/'
      assign wa_collection_path_part = wa_request_path | split: '/collections/' | last | split: '/products/' | first
      if wa_collection_path_part contains 'women' or wa_collection_path_part contains 'womens'
        assign wa_view_context = 'women'
      elsif wa_collection_path_part contains 'men' or wa_collection_path_part contains 'mens'
        assign wa_view_context = 'men'
      elsif wa_collection_path_part == 'shirts' or wa_collection_path_part == 'trousers'
        assign wa_view_context = 'men'
      endif
    endif
  endif
-%}

{{- wa_view_context -}}
