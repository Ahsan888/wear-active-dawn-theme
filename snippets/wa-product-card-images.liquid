{% comment %}
  Wear Active custom code start - wa-product-card-images.liquid
  Product card images with premium desktop hover fade to second image.

  Accepts:
  - card_product: {Object} Product Liquid object.
  - card_collection: {Object} Collection object for contextual card image selection (optional).
  - card_primary_image: {Object} Resolved primary image for contextual card rendering (optional).
  - enable_swatch_preview: {Boolean} Include swatch preview image layer. Default: false (optional).
{% endcomment %}

{%- liquid
  assign wa_card_primary = card_primary_image | default: card_product.featured_media
  capture wa_card_context
    render 'wa-contextual-card-image', card_collection: card_collection
  endcapture
  assign wa_card_context = wa_card_context | strip

  if card_primary_image == blank and wa_card_context == 'womens' and card_product.metafields.custom.womens_card_image.value != blank
    assign wa_card_primary = card_product.metafields.custom.womens_card_image.value
  elsif card_primary_image == blank and wa_card_context == 'mens' and card_product.metafields.custom.mens_card_image.value != blank
    assign wa_card_primary = card_product.metafields.custom.mens_card_image.value
  endif

  if wa_card_primary.image != blank
    assign wa_card_primary = wa_card_primary.image
  elsif wa_card_primary.preview_image != blank
    assign wa_card_primary = wa_card_primary.preview_image
  endif

  assign wa_card_secondary = card_product.media[1]
  if wa_card_context == 'womens'
    if card_product.metafields.custom.womens_hover_image.value != blank
      assign wa_card_secondary = card_product.metafields.custom.womens_hover_image.value
    elsif card_product.metafields.custom.womens_gallery_images.value != blank
      for wa_gallery_image in card_product.metafields.custom.womens_gallery_images.value
        if forloop.index == 2
          assign wa_card_secondary = wa_gallery_image
          break
        endif
      endfor
    endif
  elsif wa_card_context == 'mens'
    if card_product.metafields.custom.mens_hover_image.value != blank
      assign wa_card_secondary = card_product.metafields.custom.mens_hover_image.value
    elsif card_product.metafields.custom.mens_gallery_images.value != blank
      for wa_gallery_image in card_product.metafields.custom.mens_gallery_images.value
        if forloop.index == 2
          assign wa_card_secondary = wa_gallery_image
          break
        endif
      endfor
    endif
  endif

  if wa_card_secondary.image != blank
    assign wa_card_secondary = wa_card_secondary.image
  elsif wa_card_secondary.preview_image != blank
    assign wa_card_secondary = wa_card_secondary.preview_image
  endif

  assign wa_card_has_hover = false
  if wa_card_secondary != null
    assign wa_card_has_hover = true
  endif

  assign wa_card_is_bundle = false
  if card_product.tags contains 'wa-product-pack' and card_product.images.size > 1
    assign wa_card_is_bundle = true
    assign wa_card_has_hover = false
  endif

  assign wa_card_max_width = settings.page_width | minus: 130 | divided_by: 4
  assign wa_card_sizes = '(min-width: ' | append: settings.page_width | append: 'px) ' | append: wa_card_max_width | append: 'px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)'
  assign wa_card_show_swatch_preview = false
  if enable_swatch_preview
    assign wa_card_show_swatch_preview = true
  endif
-%}

<div class="media media--transparent wa-product-card__media{% if wa_card_has_hover %} wa-product-card__media--hover{% endif %}{% if wa_card_is_bundle %} wa-product-card__media--bundle{% endif %}">
  {%- if wa_card_is_bundle -%}
    <div class="wa-bundle-card-collage wa-bundle-card-collage--{{ card_product.images.size | at_most: 3 }}">
      {%- for wa_bundle_image in card_product.images limit: 3 -%}
        <div class="wa-bundle-card-collage__panel">
          <img
            src="{{ wa_bundle_image | image_url: width: 480 }}"
            srcset="
              {{ wa_bundle_image | image_url: width: 180 }} 180w,
              {{ wa_bundle_image | image_url: width: 320 }} 320w,
              {{ wa_bundle_image | image_url: width: 480 }} 480w
            "
            sizes="{{ wa_card_sizes }}"
            alt="{{ wa_bundle_image.alt | default: card_product.title | escape }} — item {{ forloop.index }}"
            class="wa-bundle-card-collage__image"
            loading="lazy"
            width="{{ wa_bundle_image.width }}"
            height="{{ wa_bundle_image.height }}"
          >
        </div>
      {%- endfor -%}
      <span class="wa-bundle-card-collage__badge">
        {{ card_product.images.size | at_most: 3 }}-piece bundle
      </span>
    </div>
  {%- else -%}
  {% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
  <img
    srcset="
      {%- if wa_card_primary.width >= 165 -%}{{ wa_card_primary | image_url: width: 165 }} 165w,{%- endif -%}
      {%- if wa_card_primary.width >= 360 -%}{{ wa_card_primary | image_url: width: 360 }} 360w,{%- endif -%}
      {%- if wa_card_primary.width >= 533 -%}{{ wa_card_primary | image_url: width: 533 }} 533w,{%- endif -%}
      {%- if wa_card_primary.width >= 720 -%}{{ wa_card_primary | image_url: width: 720 }} 720w,{%- endif -%}
      {%- if wa_card_primary.width >= 940 -%}{{ wa_card_primary | image_url: width: 940 }} 940w,{%- endif -%}
      {%- if wa_card_primary.width >= 1066 -%}{{ wa_card_primary | image_url: width: 1066 }} 1066w,{%- endif -%}
      {{ wa_card_primary | image_url }} {{ wa_card_primary.width }}w
    "
    src="{{ wa_card_primary | image_url: width: 533 }}"
    sizes="{{ wa_card_sizes }}"
    alt="{{ wa_card_primary.alt | default: card_product.title | escape }}"
    class="wa-product-card__image wa-product-card__image--primary motion-reduce"
    {% unless lazy_load == false %}
      loading="lazy"
    {% endunless %}
    width="{{ wa_card_primary.width }}"
    height="{{ wa_card_primary.height }}"
  >
  {% comment %}theme-check-enable ImgLazyLoading{% endcomment %}

  {%- if wa_card_has_hover -%}
    <img
      srcset="
        {%- if wa_card_secondary.width >= 165 -%}{{ wa_card_secondary | image_url: width: 165 }} 165w,{%- endif -%}
        {%- if wa_card_secondary.width >= 360 -%}{{ wa_card_secondary | image_url: width: 360 }} 360w,{%- endif -%}
        {%- if wa_card_secondary.width >= 533 -%}{{ wa_card_secondary | image_url: width: 533 }} 533w,{%- endif -%}
        {%- if wa_card_secondary.width >= 720 -%}{{ wa_card_secondary | image_url: width: 720 }} 720w,{%- endif -%}
        {%- if wa_card_secondary.width >= 940 -%}{{ wa_card_secondary | image_url: width: 940 }} 940w,{%- endif -%}
        {%- if wa_card_secondary.width >= 1066 -%}{{ wa_card_secondary | image_url: width: 1066 }} 1066w,{%- endif -%}
        {{ wa_card_secondary | image_url }} {{ wa_card_secondary.width }}w
      "
      src="{{ wa_card_secondary | image_url: width: 533 }}"
      sizes="{{ wa_card_sizes }}"
      alt="{{ wa_card_secondary.alt | escape }}"
      class="wa-product-card__image wa-product-card__image--secondary motion-reduce"
      loading="lazy"
      width="{{ wa_card_secondary.width }}"
      height="{{ wa_card_secondary.height }}"
    >
  {%- endif -%}

  {%- if wa_card_show_swatch_preview -%}
    <img
      class="wa-product-card__image wa-product-card__image--swatch-preview motion-reduce"
      alt=""
      width="{{ wa_card_primary.width }}"
      height="{{ wa_card_primary.height }}"
      hidden
      decoding="async"
    >
  {%- endif -%}
  {%- endif -%}
</div>
