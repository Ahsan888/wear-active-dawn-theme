{% comment %}
  Wear Active — returns a single Size Chart Row field value.

  Accepts:
  - row: {Object} Size Chart Row metaobject.
  - field: {String} size, chest, waist, hips, length, or inseam.
{% endcomment %}
{%- case field -%}
  {%- when 'size' -%}
    {{- row.size.value | default: row.size -}}
  {%- when 'chest' -%}
    {{- row.chest.value | default: row.chest -}}
  {%- when 'waist' -%}
    {{- row.waist.value | default: row.waist -}}
  {%- when 'hips' -%}
    {{- row.hips.value | default: row.hips -}}
  {%- when 'length' -%}
    {{- row.length.value | default: row.length -}}
  {%- when 'inseam' -%}
    {{- row.inseam.value | default: row.inseam -}}
{%- endcase -%}
