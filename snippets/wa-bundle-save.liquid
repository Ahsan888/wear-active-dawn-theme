{% comment %}
  Wear Active custom code start — wa-bundle-save.liquid
  Informational Bundle & Save offers for eligible PDPs.
  Discounts are applied by Shopify automatic discounts at checkout.

  Accepts:
  - block: {Object} Theme editor block settings.
  - product: {Object} Current product.
{% endcomment %}

{%- if block.settings.enable -%}
  {%- liquid
    assign wa_bundle_kind = blank
    assign wa_bundle_from_tag = false
    assign wa_tee_terms = 'tee,t-shirt,shirt' | split: ','
    assign wa_trouser_terms = 'trouser' | split: ','
    assign wa_exclude_terms = 'hoodie,hoody,zipper,zip-up,zip up,winter,therma,jacket' | split: ','

    if product.tags contains 'bundle-tee'
      assign wa_bundle_kind = 'tee'
      assign wa_bundle_from_tag = true
    elsif product.tags contains 'bundle-trouser'
      assign wa_bundle_kind = 'trouser'
      assign wa_bundle_from_tag = true
    endif

    unless wa_bundle_from_tag
      assign wa_type_lower = product.type | downcase
      assign wa_title_lower = product.title | downcase
      assign wa_exclude = false

      for wa_exclude_term in wa_exclude_terms
        if wa_type_lower contains wa_exclude_term or wa_title_lower contains wa_exclude_term
          assign wa_exclude = true
          break
        endif
      endfor

      unless wa_exclude
        for wa_tag in product.tags
          assign wa_tag_lower = wa_tag | downcase
          for wa_exclude_term in wa_exclude_terms
            if wa_tag_lower contains wa_exclude_term
              assign wa_exclude = true
              break
            endif
          endfor
          if wa_exclude
            break
          endif
        endfor
      endunless

      unless wa_exclude
        for wa_term in wa_tee_terms
          if wa_type_lower contains wa_term
            assign wa_bundle_kind = 'tee'
            break
          endif
        endfor

        if wa_bundle_kind == blank
          for wa_term in wa_trouser_terms
            if wa_type_lower contains wa_term
              assign wa_bundle_kind = 'trouser'
              break
            endif
          endfor
        endif

        if wa_bundle_kind == blank
          for wa_collection in product.collections
            assign wa_handle_lower = wa_collection.handle | downcase

            unless wa_bundle_kind == 'tee'
              for wa_term in wa_tee_terms
                if wa_handle_lower contains wa_term
                  assign wa_bundle_kind = 'tee'
                  break
                endif
              endfor
            endunless

            if wa_bundle_kind == blank
              for wa_term in wa_trouser_terms
                if wa_handle_lower contains wa_term
                  assign wa_bundle_kind = 'trouser'
                  break
                endif
              endfor
            endif

            if wa_bundle_kind != blank
              break
            endif
          endfor
        endif
      endunless
    endunless
  -%}

  {%- if wa_bundle_kind != blank -%}
    {%- liquid
      if wa_bundle_kind == 'tee'
        assign wa_item_plural = 'Tees'
        assign wa_save_2 = block.settings.tee_save_2
        assign wa_save_3 = block.settings.tee_save_3
        assign wa_cta_text = block.settings.tee_cta_text
        assign wa_cta_url = block.settings.tee_collection_url
      else
        assign wa_item_plural = 'Trousers'
        assign wa_save_2 = block.settings.trouser_save_2
        assign wa_save_3 = blank
        assign wa_cta_text = block.settings.trouser_cta_text
        assign wa_cta_url = block.settings.trouser_collection_url
      endif

      assign wa_heading = block.settings.heading
      assign wa_checkout_note = block.settings.checkout_note
      assign wa_best_save = wa_save_3 | default: wa_save_2
    -%}

    <div class="wa-bundle-save quick-add-hidden" {{ block.shopify_attributes }}>
      <details class="wa-bundle-save__details">
        <summary class="wa-bundle-save__summary">
          <span class="wa-bundle-save__icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" focusable="false">
              <path d="M11.2 2.5h5.3l1 1v5.3l-8.8 8.8a1.4 1.4 0 0 1-2 0L2.5 12.6a1.4 1.4 0 0 1 0-2L11.2 2.5Z" stroke="currentColor" stroke-width="1.35" stroke-linejoin="round"/>
              <circle cx="13.8" cy="6.2" r="0.95" fill="currentColor"/>
            </svg>
          </span>
          <span class="wa-bundle-save__summary-copy">
            <strong>{{ wa_heading | default: 'Bundle & Save' | escape }}</strong>
            {%- if wa_best_save != blank -%}
              <span>Save up to {{ wa_best_save | escape }}</span>
            {%- endif -%}
          </span>
          <span class="wa-bundle-save__chevron" aria-hidden="true">⌄</span>
        </summary>

        <div class="wa-bundle-save__content">
          <div class="wa-bundle-save__tiers{% unless wa_bundle_kind == 'tee' and wa_save_3 != blank %} wa-bundle-save__tiers--single{% endunless %}">
            <div class="wa-bundle-save__tier">
              <span>Buy 2 {{ wa_item_plural }}</span>
              {%- if wa_save_2 != blank -%}
                <strong>{{ block.settings.save_prefix | escape }}{{ wa_save_2 | escape }}</strong>
              {%- endif -%}
            </div>

            {%- if wa_bundle_kind == 'tee' and wa_save_3 != blank -%}
              <div class="wa-bundle-save__tier wa-bundle-save__tier--best">
                <span>Buy 3 {{ wa_item_plural }}</span>
                <strong>{{ block.settings.save_prefix | escape }}{{ wa_save_3 | escape }}</strong>
              </div>
            {%- endif -%}
          </div>

          <div class="wa-bundle-save__footer">
            {%- if wa_checkout_note != blank -%}
              <span class="wa-bundle-save__note">Applied automatically at checkout</span>
            {%- endif -%}

            {%- if block.settings.show_cta and wa_cta_text != blank and wa_cta_url != blank -%}
              <a href="{{ wa_cta_url | escape }}" class="wa-bundle-save__cta link underlined-link">
                <span>{{ wa_cta_text | escape }}</span>
                <span aria-hidden="true">→</span>
              </a>
            {%- endif -%}
          </div>
        </div>
      </details>
    </div>
  {%- endif -%}
{%- endif -%}
