{% comment %}
  Wear Active custom code start — wa-bundle-save.liquid

  Interactive, margin-safe quantity bundle picker. Eligibility is explicit:
  - bundle-tee: Buy 2 / Buy 3
  - bundle-bottom (or legacy bundle-trouser): Buy 2

  Eligible products are loaded from hidden automated collections whose members
  carry the matching tag. Shopify automatic discounts remain the pricing
  authority; this component only assembles selected variants in one cart add.

  Accepts:
  - block: {Object} Theme editor block settings.
  - product: {Object} Current product.
  - product_form_id: {String} Main product form ID.
{% endcomment %}

{%- liquid
  assign wa_bundle_kind = blank
  if product.tags contains 'bundle-tee'
    assign wa_bundle_kind = 'tee'
  elsif product.tags contains 'bundle-bottom' or product.tags contains 'bundle-trouser'
    assign wa_bundle_kind = 'bottom'
  endif

  if wa_bundle_kind == 'tee'
    assign wa_bundle_collection = collections[block.settings.tee_collection_handle]
    assign wa_save_2 = block.settings.tee_save_2
    assign wa_save_3 = block.settings.tee_save_3
    assign wa_item_label = 'tee'
    assign wa_item_plural = 'tees'
  elsif wa_bundle_kind == 'bottom'
    assign wa_bundle_collection = collections[block.settings.bottom_collection_handle]
    assign wa_save_2 = block.settings.bottom_save_2
    assign wa_save_3 = 0
    assign wa_item_label = 'bottom'
    assign wa_item_plural = 'bottoms'
  endif
-%}

{%- if block.settings.enable and wa_bundle_kind != blank and wa_bundle_collection != blank -%}
  {{ 'wa-bundle-picker.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'wa-bundle-picker.js' | asset_url }}" defer="defer"></script>

  {%- capture wa_current_color_data -%}
    {%- render 'wa-color-from-product', product: product -%}
  {%- endcapture -%}
  {%- assign wa_current_color = wa_current_color_data | strip | split: '|' | first | strip -%}

  <wa-bundle-picker
    class="wa-bundle-picker"
    data-kind="{{ wa_bundle_kind }}"
    data-form-id="{{ product_form_id }}"
    data-current-product-id="{{ product.id }}"
    data-current-variant-id="{{ product.selected_or_first_available_variant.id }}"
    data-save-2="{{ wa_save_2 | times: 100 }}"
    data-save-3="{{ wa_save_3 | times: 100 }}"
    data-item-label="{{ wa_item_label }}"
    data-item-plural="{{ wa_item_plural }}"
    {{ block.shopify_attributes }}
  >
    <div class="wa-bundle-picker__header">
      <div>
        <p class="wa-bundle-picker__eyebrow">Build your rotation</p>
        <h3 class="wa-bundle-picker__heading">{{ block.settings.heading | default: 'Bundle & Save' | escape }}</h3>
      </div>
      <span class="wa-bundle-picker__automatic">Automatic saving</span>
    </div>

    <div class="wa-bundle-picker__tiers" role="radiogroup" aria-label="Choose bundle quantity">
      <button
        class="wa-bundle-picker__tier is-selected"
        type="button"
        role="radio"
        aria-checked="true"
        data-wa-bundle-tier="1"
        data-wa-bundle-saving="0"
      >
        <span>Buy 1</span>
        <strong data-wa-tier-price="1">{{ product.selected_or_first_available_variant.price | money }}</strong>
        <small>Regular price</small>
      </button>
      <button
        class="wa-bundle-picker__tier"
        type="button"
        role="radio"
        aria-checked="false"
        data-wa-bundle-tier="2"
        data-wa-bundle-saving="{{ wa_save_2 | times: 100 }}"
      >
        <span>Buy 2</span>
        <strong>Save {{ wa_save_2 | times: 100 | money }}</strong>
        <small>Mix styles &amp; sizes</small>
      </button>
      {%- if wa_bundle_kind == 'tee' -%}
        <button
          class="wa-bundle-picker__tier wa-bundle-picker__tier--featured"
          type="button"
          role="radio"
          aria-checked="false"
          data-wa-bundle-tier="3"
          data-wa-bundle-saving="{{ wa_save_3 | times: 100 }}"
        >
          <span class="wa-bundle-picker__badge">Best value</span>
          <span>Buy 3</span>
          <strong>Save {{ wa_save_3 | times: 100 | money }}</strong>
          <small>Mix styles &amp; sizes</small>
        </button>
      {%- endif -%}
    </div>

    <div class="wa-bundle-picker__selection" data-wa-bundle-selection hidden>
      <p class="wa-bundle-picker__selection-title">
        Choose each <span>{{ wa_item_label }}</span>
      </p>

      <div class="wa-bundle-picker__slot wa-bundle-picker__slot--current" data-wa-bundle-current-slot>
        <div class="wa-bundle-picker__slot-number">1</div>
        <div class="wa-bundle-picker__slot-copy">
          <strong>{{ product.title | escape }}{% if wa_current_color != blank %} · {{ wa_current_color | escape }}{% endif %}</strong>
          <span data-wa-current-variant-title>{{ product.selected_or_first_available_variant.title | escape }}</span>
        </div>
        <span class="wa-bundle-picker__slot-status">Selected above</span>
      </div>

      <div data-wa-bundle-extra-slots></div>
    </div>

    <p class="wa-bundle-picker__summary" aria-live="polite" data-wa-bundle-summary></p>
    <p class="wa-bundle-picker__error" role="alert" data-wa-bundle-error hidden></p>

    <script type="application/json" data-wa-current-product>
      {
        "id": {{ product.id | json }},
        "title": {{ product.title | json }},
        "color": {{ wa_current_color | json }},
        "image": {{ product.featured_image | image_url: width: 180 | json }},
        "variants": [
          {%- for variant in product.variants -%}
            {%- unless forloop.first -%},{%- endunless -%}
            {
              "id": {{ variant.id | json }},
              "title": {{ variant.title | json }},
              "available": {{ variant.available | json }},
              "price": {{ variant.price | json }},
              "sku": {{ variant.sku | json }}
            }
          {%- endfor -%}
        ]
      }
    </script>

    <script type="application/json" data-wa-bundle-products>
      [
        {%- assign wa_first_bundle_product = true -%}
        {%- for wa_product in wa_bundle_collection.products limit: 50 -%}
          {%- if wa_product.available -%}
            {%- capture wa_product_color_data -%}
              {%- render 'wa-color-from-product', product: wa_product -%}
            {%- endcapture -%}
            {%- assign wa_product_color = wa_product_color_data | strip | split: '|' | first | strip -%}
            {%- unless wa_first_bundle_product -%},{%- endunless -%}
            {
              "id": {{ wa_product.id | json }},
              "title": {{ wa_product.title | json }},
              "color": {{ wa_product_color | json }},
              "url": {{ wa_product.url | json }},
              "image": {{ wa_product.featured_image | image_url: width: 180 | json }},
              "variants": [
                {%- for variant in wa_product.variants -%}
                  {%- unless forloop.first -%},{%- endunless -%}
                  {
                    "id": {{ variant.id | json }},
                    "title": {{ variant.title | json }},
                    "available": {{ variant.available | json }},
                    "price": {{ variant.price | json }},
                    "sku": {{ variant.sku | json }}
                  }
                {%- endfor -%}
              ]
            }
            {%- assign wa_first_bundle_product = false -%}
          {%- endif -%}
        {%- endfor -%}
      ]
    </script>
  </wa-bundle-picker>
{%- endif -%}
