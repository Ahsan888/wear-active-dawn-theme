{% comment %}
  Wear Active custom code start — wa-footer-menu-links.liquid
  Curated footer links for Support and About columns.

  Accepts:
  - menu_group: {String} support or about.
{% endcomment %}

{%- liquid
  assign wa_footer_contact_url = routes.root_url
  if pages.contact != blank
    assign wa_footer_contact_url = pages.contact.url
  elsif pages['contact-us'] != blank
    assign wa_footer_contact_url = pages['contact-us'].url
  endif

  assign wa_footer_about_url = routes.root_url
  if pages.about != blank
    assign wa_footer_about_url = pages.about.url
  elsif pages['about-us'] != blank
    assign wa_footer_about_url = pages['about-us'].url
  endif

  capture wa_footer_exchange_url
    render 'wa-exchange-policy-url'
  endcapture
  assign wa_footer_exchange_url = wa_footer_exchange_url | strip

  assign wa_footer_shipping_url = blank
  if pages['shipping-delivery'] != blank
    assign wa_footer_shipping_url = pages['shipping-delivery'].url
  elsif pages.shipping != blank
    assign wa_footer_shipping_url = pages.shipping.url
  elsif shop.shipping_policy.body != blank
    assign wa_footer_shipping_url = shop.shipping_policy.url
  endif
  if wa_footer_shipping_url == blank
    assign wa_footer_shipping_url = '/policies/shipping-policy'
  endif

  assign wa_footer_whatsapp_digits = settings.wa_whatsapp_number | remove: '+' | remove: ' ' | remove: '-'
  assign wa_footer_support_message = 'Hi Wear Active, I need help.' | url_encode
  assign wa_footer_tracking_message = 'Hi Wear Active, I need help tracking my order.' | url_encode
  assign wa_footer_whatsapp_url = 'https://wa.me/' | append: wa_footer_whatsapp_digits | append: '?text=' | append: wa_footer_support_message
  assign wa_footer_tracking_url = 'https://wa.me/' | append: wa_footer_whatsapp_digits | append: '?text=' | append: wa_footer_tracking_message

  assign wa_footer_men_url = routes.collections_url | append: '/men'
  if collections.men != blank
    assign wa_footer_men_url = collections.men.url
  endif

  assign wa_footer_women_url = routes.collections_url | append: '/women'
  if collections.women != blank
    assign wa_footer_women_url = collections.women.url
  elsif collections['women-s-performance-collection'] != blank
    assign wa_footer_women_url = collections['women-s-performance-collection'].url
  endif

  assign wa_footer_sale_url = routes.collections_url | append: '/sale'
  if collections.sale != blank
    assign wa_footer_sale_url = collections.sale.url
  endif

  assign wa_footer_best_url = routes.collections_url | append: '/all'
  if collections['✨-best-selling-collection-✨'] != blank
    assign wa_footer_best_url = collections['✨-best-selling-collection-✨'].url
  endif
-%}

<ul class="footer-block__details-content list-unstyled wa-footer__menu-links">
  {%- if menu_group == 'support' -%}
    <li>
      <a
        href="{{ wa_footer_whatsapp_url }}"
        class="link link--text list-menu__item list-menu__item--link"
        target="_blank"
        rel="noopener"
      >
        WhatsApp Support
      </a>
    </li>
    <li>
      <a href="{{ wa_footer_contact_url }}" class="link link--text list-menu__item list-menu__item--link">
        Contact &amp; Help
      </a>
    </li>
    <li>
      <a href="{{ wa_footer_shipping_url }}" class="link link--text list-menu__item list-menu__item--link">
        Shipping &amp; Delivery
      </a>
    </li>
    <li>
      <a href="{{ wa_footer_exchange_url }}" class="link link--text list-menu__item list-menu__item--link">
        Size Exchange Policy
      </a>
    </li>
    <li>
      <a
        href="{{ wa_footer_tracking_url }}"
        class="link link--text list-menu__item list-menu__item--link"
        target="_blank"
        rel="noopener"
      >
        Track Your Order
      </a>
    </li>
  {%- elsif menu_group == 'about' -%}
    <li>
      <a href="{{ wa_footer_about_url }}" class="link link--text list-menu__item list-menu__item--link">
        About Us
      </a>
    </li>
    <li>
      <a href="{{ wa_footer_men_url }}" class="link link--text list-menu__item list-menu__item--link">
        Men
      </a>
    </li>
    <li>
      <a href="{{ wa_footer_women_url }}" class="link link--text list-menu__item list-menu__item--link">
        Women
      </a>
    </li>
    <li>
      <a href="{{ wa_footer_sale_url }}" class="link link--text list-menu__item list-menu__item--link">
        Sale
      </a>
    </li>
    <li>
      <a href="{{ wa_footer_best_url }}" class="link link--text list-menu__item list-menu__item--link">
        Best Sellers
      </a>
    </li>
  {%- endif -%}
</ul>
