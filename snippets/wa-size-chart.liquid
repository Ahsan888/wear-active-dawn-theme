{% comment %}
  Wear Active custom code start — wa-size-chart.liquid
  Renders Size Guide trigger and modal from product metafield metaobject.

  Accepts:
  - product: {Object} Product object.
  - section_id: {String} Section ID for unique element IDs.

  Metafield: product.metafields.custom.size_chart (metaobject)
  Fields: title, description, fit_type, measurement_image, rows
  Row metaobject: size, chest, waist, hips, length, inseam
{% endcomment %}

{%- assign size_chart = product.metafields.custom.size_chart.value -%}
{%- if size_chart != blank -%}
  {%- liquid
    assign modal_id = 'wa-size-chart-' | append: section_id
    assign title_id = modal_id | append: '-title'
    assign wa_column_order = 'chest,waist,hips,length,inseam' | split: ','
    assign wa_column_labels = 'Chest,Waist,Hips,Length,Inseam' | split: ','
    assign wa_fit_type = size_chart.fit_type.value | default: size_chart.fit_type
    assign wa_fit_description = size_chart.description | metafield_text | strip_html | strip
  -%}

  <div class="wa-size-chart" data-wa-size-chart>
    <button
      type="button"
      class="wa-size-chart__trigger"
      aria-controls="{{ modal_id }}"
      aria-expanded="false"
      aria-haspopup="dialog"
      data-wa-size-chart-open
    >
      <span class="wa-size-chart__trigger-icon" aria-hidden="true">
        <svg viewBox="0 0 20 20" fill="none" focusable="false">
          <path d="M3 13.5 13.5 3 17 6.5 6.5 17 3 13.5Z" stroke="currentColor" stroke-width="1.35" stroke-linejoin="round"/>
          <path d="m11.3 5.2 1.6 1.6M8.8 7.7l1.15 1.15M6.3 10.2l1.6 1.6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
        </svg>
      </span>
      <span>Size Guide</span>
    </button>

    {%- if wa_fit_type != blank or wa_fit_description != blank -%}
      <div class="wa-size-chart__fit-summary" data-wa-size-fit-summary>
        <div class="wa-size-chart__fit-summary-heading">
          <span class="wa-size-chart__fit-summary-label">Fit</span>
          {%- if wa_fit_type != blank -%}
            <strong class="wa-size-chart__fit-summary-copy">{{ wa_fit_type | escape }}</strong>
          {%- endif -%}
        </div>
        {%- if wa_fit_description != blank -%}
          <p class="wa-size-chart__fit-summary-guidance">{{ wa_fit_description | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <wa-modal
      id="{{ modal_id }}"
      class="wa-size-chart__modal"
      aria-hidden="true"
    >
      <div class="wa-modal__overlay" tabindex="-1"></div>

      <div
        class="wa-modal__dialog wa-size-chart__dialog"
        role="dialog"
        aria-modal="true"
        {%- if size_chart.title != blank -%}
          aria-labelledby="{{ title_id }}"
        {%- else -%}
          aria-label="Size Guide"
        {%- endif -%}
        tabindex="-1"
        data-wa-modal-focus
      >
        <button
          type="button"
          class="wa-modal__close wa-size-chart__close"
          data-wa-modal-close
          aria-label="{{ 'accessibility.close' | t }}"
        >
          <span class="svg-wrapper">
            {{- 'icon-close.svg' | inline_asset_content -}}
          </span>
        </button>

        <div class="wa-modal__content wa-size-chart__content">
          {%- if size_chart.title != blank -%}
            <h2 id="{{ title_id }}" class="wa-size-chart__title h2">
              {{- size_chart.title.value | default: size_chart.title | escape -}}
            </h2>
          {%- endif -%}

          {%- if size_chart.fit_type != blank -%}
            <p class="wa-size-chart__fit-type">
              <span class="wa-size-chart__fit-type-label">Fit</span>
              <span class="wa-size-chart__fit-type-value">
                {{- size_chart.fit_type.value | default: size_chart.fit_type | escape -}}
              </span>
            </p>
          {%- endif -%}

          {%- if size_chart.description != blank -%}
            <div class="wa-size-chart__description rte">
              {{ size_chart.description | metafield_tag }}
            </div>
          {%- endif -%}

          {%- assign size_chart_rows = size_chart.rows.value -%}
          {%- if size_chart_rows != blank and size_chart_rows.size > 0 -%}
            {%- liquid
              assign wa_active_columns = ''

              comment
                Pass 1: scan rows and record measurement columns with at least one value.
              endcomment
              for row in size_chart_rows
                for column_key in wa_column_order
                  capture column_value
                    render 'wa-size-chart-field', row: row, field: column_key
                  endcapture
                  assign column_value = column_value | strip

                  if column_value != blank
                    assign column_token = column_key | append: ','
                    unless wa_active_columns contains column_token
                      assign wa_active_columns = wa_active_columns | append: column_token
                    endunless
                  endif
                endfor
              endfor
            -%}

            <div class="wa-size-chart__table-scroll" tabindex="0" role="region" aria-label="Size measurements">
              <table class="wa-size-chart__table">
                <thead>
                  <tr>
                    <th scope="col">Size</th>
                    {%- for column_key in wa_column_order -%}
                      {%- assign column_token = column_key | append: ',' -%}
                      {%- if wa_active_columns contains column_token -%}
                        <th scope="col">
                          {{- wa_column_labels[forloop.index0] -}}
                        </th>
                      {%- endif -%}
                    {%- endfor -%}
                  </tr>
                </thead>
                <tbody>
                  {%- for row in size_chart_rows -%}
                    {%- capture row_size -%}
                      {%- render 'wa-size-chart-field', row: row, field: 'size' -%}
                    {%- endcapture -%}
                    {%- assign row_size = row_size | strip -%}
                    <tr>
                      <th scope="row">
                        {%- if row_size != blank -%}
                          {{- row_size | escape -}}
                        {%- else -%}
                          &mdash;
                        {%- endif -%}
                      </th>
                      {%- for column_key in wa_column_order -%}
                        {%- assign column_token = column_key | append: ',' -%}
                        {%- if wa_active_columns contains column_token -%}
                          {%- capture cell_value -%}
                            {%- render 'wa-size-chart-field', row: row, field: column_key -%}
                          {%- endcapture -%}
                          <td>
                            {%- render 'wa-size-chart-format', value: cell_value -%}
                          </td>
                        {%- endif -%}
                      {%- endfor -%}
                    </tr>
                  {%- endfor -%}
                </tbody>
              </table>
            </div>
          {%- endif -%}

          {%- if size_chart.measurement_image != blank -%}
            {%- liquid
              assign measurement_alt = size_chart.title.value | default: size_chart.title | default: 'Size measurement guide' | escape
            -%}
            <div class="wa-size-chart__image-wrap">
              {{
                size_chart.measurement_image.value
                | default: size_chart.measurement_image
                | image_url: width: 1200
                | image_tag:
                  class: 'wa-size-chart__image',
                  loading: 'lazy',
                  widths: '375, 550, 750, 1100, 1200',
                  sizes: '(min-width: 780px) 720px, 100vw',
                  alt: measurement_alt
              }}
            </div>
          {%- endif -%}
        </div>
      </div>
    </wa-modal>
  </div>
{%- endif -%}
