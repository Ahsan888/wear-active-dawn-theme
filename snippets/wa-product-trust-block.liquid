{% comment %}
  Wear Active custom code start — wa-product-trust-block.liquid
  PDP delivery and trust reassurance items.

  Accepts:
  - block: {Object} Theme editor block with trust item settings.
{% endcomment %}

{%- if block.settings.enable -%}
  <div class="wa-product-trust quick-add-hidden" {{ block.shopify_attributes }}>
    <ul class="wa-product-trust__list" role="list" aria-label="Wear Active trust benefits">
      {%- for wa_trust_index in (1..4) -%}
        {%- assign wa_trust_key = 'item_' | append: wa_trust_index -%}
        {%- assign wa_trust_subtext_key = 'item_' | append: wa_trust_index | append: '_subtext' -%}
        {%- assign wa_trust_text = block.settings[wa_trust_key] -%}
        {%- assign wa_trust_subtext = block.settings[wa_trust_subtext_key] -%}
        {%- if wa_trust_text != blank -%}
          <li class="wa-product-trust__item" role="listitem">
            <span class="wa-product-trust__icon" aria-hidden="true">
              {%- case wa_trust_index -%}
                {%- when 1 -%}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" focusable="false">
                    <path d="M5 17a2 2 0 1 0 4 0 2 2 0 1 0-4 0" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M15 17a2 2 0 1 0 4 0 2 2 0 1 0-4 0" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M5 17H3v-4M2 5h11v12M9 17h6M19 17h2v-6h-8M13 6h5l3 5M3 9h4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {%- when 2 -%}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" focusable="false">
                    <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M21 3v5h-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M8 16H3v5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {%- when 3 -%}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" focusable="false">
                    <path d="M4 4 20 20M20 4 4 20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                    <path d="M7 3 21 17M17 3 3 17M3 7l14 14M21 7 7 21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                    <path d="M12 2.8 21.2 12 12 21.2 2.8 12 12 2.8Z" stroke="currentColor" stroke-width="1.45" stroke-linejoin="round"/>
                  </svg>
                {%- else -%}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" focusable="false">
                    <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
              {%- endcase -%}
            </span>
            <span class="wa-product-trust__copy">
              <span class="wa-product-trust__text">{{ wa_trust_text | escape }}</span>
              {%- if wa_trust_subtext != blank -%}
                <span class="wa-product-trust__subtext">{{ wa_trust_subtext | escape }}</span>
              {%- endif -%}
            </span>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

    <div class="wa-product-trust__proof" aria-label="Store support details">
      <div class="wa-product-trust__proof-item">
        <span class="wa-product-trust__proof-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 18 18" fill="none" focusable="false">
            <path d="M9 1.9 15 4.45v4.4c0 3.7-2.35 6.05-6 7.25-3.65-1.2-6-3.55-6-7.25v-4.4L9 1.9Z" stroke="currentColor" stroke-width="1.35" stroke-linejoin="round"/>
            <path d="M6.55 9.05 8.25 10.75 11.65 7.35" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span>COD Confirmed on WhatsApp</span>
      </div>
      <div class="wa-product-trust__proof-item">
        <span class="wa-product-trust__flag" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 28 18" focusable="false">
            <rect width="28" height="18" rx="1.2" fill="#ffffff"/>
            <rect x="6" width="22" height="18" rx="1.2" fill="#115c35"/>
            <path d="M18.1 5.1a4 4 0 1 0 0 7.8 4.4 4.4 0 1 1 0-7.8Z" fill="#ffffff"/>
            <path d="m21.2 6.2.55 1.45 1.55.08-1.2.98.4 1.5-1.3-.85-1.3.85.4-1.5-1.2-.98 1.55-.08.55-1.45Z" fill="#ffffff"/>
          </svg>
        </span>
        <span>Leopards &amp; Trax</span>
      </div>
      <a
        class="wa-product-trust__proof-item wa-product-trust__proof-link"
        href="https://wa.me/{{ settings.wa_whatsapp_number | remove: '+' | remove: ' ' | remove: '-' }}?text={{ 'Hi Wear Active, I need help with a product.' | url_encode }}"
        target="_blank"
        rel="noopener"
      >
        <span class="wa-product-trust__proof-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 18 18" fill="none" focusable="false">
            <path d="M3.25 15 4 12.2a6.5 6.5 0 1 1 2 1.85L3.25 15Z" stroke="currentColor" stroke-width="1.35" stroke-linejoin="round"/>
            <path d="M6.75 6.4c.2 2.45 1.8 4.05 4.2 4.4l1.02-1.02c.18-.18.18-.47 0-.65l-.78-.78c-.18-.18-.47-.18-.65 0l-.43.43A3.8 3.8 0 0 1 8.2 6.86l.43-.43c.18-.18.18-.47 0-.65L7.85 5c-.18-.18-.47-.18-.65 0L6.2 6c-.15.15-.2.33-.17.52.16-.08.39-.12.72-.12Z" fill="currentColor"/>
          </svg>
        </span>
        <span>WhatsApp Support</span>
      </a>
    </div>

    <p class="wa-product-trust__delivery-note">
      <span class="wa-product-trust__delivery-icon" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 18 18" fill="none" focusable="false">
          <path d="M4 5.25h6.75v5.5H4v-5.5Z" stroke="currentColor" stroke-width="1.35" stroke-linejoin="round"/>
          <path d="M10.75 7h2.45l1.8 1.95v1.8h-4.25V7Z" stroke="currentColor" stroke-width="1.35" stroke-linejoin="round"/>
          <path d="M5.85 13.2a1.25 1.25 0 1 0 0-2.5 1.25 1.25 0 0 0 0 2.5ZM12.95 13.2a1.25 1.25 0 1 0 0-2.5 1.25 1.25 0 0 0 0 2.5Z" stroke="currentColor" stroke-width="1.35"/>
          <path d="M1.8 6.45h3M1.25 8.25H5M2.15 10.05H5" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/>
        </svg>
      </span>
      <span>Free delivery in {{ settings.wa_delivery_window | escape }}. Tracking shared on WhatsApp.</span>
    </p>
  </div>
{%- endif -%}
