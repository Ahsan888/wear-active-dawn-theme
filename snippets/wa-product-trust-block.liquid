{% comment %}
  Wear Active custom code start — wa-product-trust-block.liquid
  PDP delivery and trust reassurance items.

  Accepts:
  - block: {Object} Theme editor block with trust item settings.
{% endcomment %}

{%- if block.settings.enable -%}
  {%- liquid
    assign wa_whatsapp_digits = settings.wa_whatsapp_number | remove: '+' | remove: ' ' | remove: '-'
    assign wa_whatsapp_message = 'Hi Wear Active, I need help choosing this product.' | url_encode
  -%}

  <aside class="wa-product-trust quick-add-hidden" aria-label="Delivery, exchange and payment information" {{ block.shopify_attributes }}>
    <ul class="wa-product-trust__list" role="list">
      <li class="wa-product-trust__item">
        {% render 'wa-brand-icon', icon: 'dispatch', class: 'wa-product-trust__icon' %}
        <span class="wa-product-trust__text">
          Free delivery across Pakistan · {{ settings.wa_delivery_window | escape }}
        </span>
      </li>
      <li class="wa-product-trust__item">
        {% render 'wa-brand-icon', icon: 'hanger', class: 'wa-product-trust__icon' %}
        <span class="wa-product-trust__text">{% render 'wa-exchange-policy', mode: 'compact' %}</span>
      </li>
    </ul>

    <div class="wa-product-trust__meta">
      <span class="wa-product-trust__payment">
        {% render 'wa-brand-icon', icon: 'payment', class: 'wa-product-trust__meta-icon' %}
        <span>{{ settings.wa_payment_methods | escape }}</span>
      </span>
      <a
        class="wa-product-trust__support"
        href="https://wa.me/{{ wa_whatsapp_digits }}?text={{ wa_whatsapp_message }}"
        target="_blank"
        rel="noopener"
      >
        {% render 'wa-brand-icon', icon: 'whatsapp', class: 'wa-product-trust__support-icon' %}
        <span>Need help? WhatsApp us</span>
      </a>
    </div>
  </aside>
{%- endif -%}
