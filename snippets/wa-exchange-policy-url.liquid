{% comment %}
  Wear Active custom code start — wa-exchange-policy-url.liquid
  Resolves the best available size exchange policy URL for footer and PDP links.
{% endcomment %}

{%- liquid
  assign wa_exchange_policy_url = blank

  if pages['exchange-return-policy'] != blank
    assign wa_exchange_policy_url = pages['exchange-return-policy'].url
  elsif pages.returns != blank
    assign wa_exchange_policy_url = pages.returns.url
  elsif pages['return-policy'] != blank
    assign wa_exchange_policy_url = pages['return-policy'].url
  endif

  if wa_exchange_policy_url == blank
    for policy in shop.policies
      if policy.handle == 'refund-policy' or policy.handle == 'return-policy'
        assign wa_exchange_policy_url = policy.url
        break
      endif
    endfor
  endif

  if wa_exchange_policy_url == blank
    assign wa_exchange_policy_url = '/policies/refund-policy'
  endif
-%}
{{- wa_exchange_policy_url -}}
