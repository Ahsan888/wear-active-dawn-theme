{% comment %}
  Wear Active custom code start — wa-linked-color-swatches.liquid
  Linked product color swatches via contextual Wear Active color metafields.

  Color name and swatch values are read from:
  product.metafields.shopify['color-pattern'].value (Shopify category Color field)

  Accepts:
  - product: {Object} Product object.
  - card_collection: {Object} Collection object for contextual card image and URL selection (optional).
  - mode: {String} product (PDP) or card (collection grid). Default: product.
  - section_id: {String} Section ID for unique element IDs.
{% endcomment %}

{%- liquid
  assign wa_mode = mode | default: 'product'
  assign wa_siblings = product.metafields.custom.color_siblings.value
  assign wa_context = ''

  if wa_mode == 'card'
    capture wa_card_context
      render 'wa-contextual-card-image', card_collection: card_collection
    endcapture
    assign wa_card_context = wa_card_context | strip
    if wa_card_context == 'womens'
      assign wa_context = 'women'
    elsif wa_card_context == 'mens'
      assign wa_context = 'men'
    endif
  else
    capture wa_view_context
      render 'wa-product-view-context'
    endcapture
    assign wa_context = wa_view_context | strip
  endif

  if wa_context == 'women' and product.metafields.custom.linked_color_products.value != blank
    assign wa_siblings = product.metafields.custom.linked_color_products.value
  endif
-%}

{%- if wa_siblings != blank and wa_siblings.size > 0 -%}
  {%- capture wa_current_color_data -%}
    {%- render 'wa-color-from-product', product: product -%}
  {%- endcapture -%}
  {%- assign wa_current_color_data = wa_current_color_data | strip -%}

  {%- liquid
    assign wa_has_any_swatch = false
    if wa_current_color_data != blank
      assign wa_has_any_swatch = true
    endif
  -%}

  {%- comment -%} Lightweight sibling check — avoids duplicate wa-color-from-product renders. {%- endcomment -%}
  {%- unless wa_has_any_swatch -%}
    {%- for sibling in wa_siblings -%}
      {%- if sibling.id != product.id -%}
        {%- assign wa_sibling_color_mf = sibling.metafields.shopify['color-pattern'] -%}
        {%- if wa_sibling_color_mf != blank and wa_sibling_color_mf.value != blank -%}
          {%- assign wa_has_any_swatch = true -%}
          {%- break -%}
        {%- elsif sibling.metafields.custom.color_hex != blank -%}
          {%- assign wa_has_any_swatch = true -%}
          {%- break -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endunless -%}

  {%- if wa_has_any_swatch -%}
    {%- assign wa_current_color_parts = wa_current_color_data | split: '|' -%}
    {%- assign wa_current_color_name = wa_current_color_parts[0] | strip -%}

    <div class="wa-linked-colors wa-linked-colors--{{ wa_mode }}">
      {%- if wa_mode == 'product' -%}
        <fieldset class="wa-linked-colors__fieldset product-form__input">
          <legend class="form__label wa-linked-colors__legend">
            Color:
            {% if wa_current_color_name != blank %}
              <span class="wa-linked-colors__value" data-wa-linked-color-value>{{ wa_current_color_name | escape }}</span>
            {% endif %}
          </legend>
          <div class="wa-linked-colors__list" role="list">
            {%- render 'wa-linked-color-swatch',
              swatch_product: product,
              card_collection: card_collection,
              is_active: true,
              mode: wa_mode,
              section_id: section_id
            -%}
            {%- for sibling in wa_siblings -%}
              {%- if sibling.id != product.id -%}
                {%- render 'wa-linked-color-swatch',
                  swatch_product: sibling,
                  card_collection: card_collection,
                  is_active: false,
                  mode: wa_mode,
                  section_id: section_id
                -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        </fieldset>
      {%- else -%}
        <div class="wa-linked-colors__list" role="list" aria-label="Available colors">
          {%- render 'wa-linked-color-swatch',
            swatch_product: product,
            card_collection: card_collection,
            is_active: true,
            mode: wa_mode,
            section_id: section_id
          -%}
          {%- for sibling in wa_siblings -%}
            {%- if sibling.id != product.id -%}
              {%- render 'wa-linked-color-swatch',
                swatch_product: sibling,
                card_collection: card_collection,
                is_active: false,
                mode: wa_mode,
                section_id: section_id
              -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}
{%- endif -%}
