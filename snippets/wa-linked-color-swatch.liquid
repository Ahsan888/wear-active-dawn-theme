{% comment %}
  Wear Active — renders a single linked color swatch.

  Accepts:
  - swatch_product: {Object} Product object.
  - card_collection: {Object} Collection object for contextual card image and URL selection (optional).
  - is_active: {Boolean} Whether this is the current product.
  - mode: {String} product or card.
  - section_id: {String} Section ID for unique element IDs.
{% endcomment %}
{%- capture wa_color_data -%}
  {%- render 'wa-color-from-product', product: swatch_product -%}
{%- endcapture -%}
{%- assign wa_color_data = wa_color_data | strip -%}
{%- if wa_color_data == blank -%}
  {%- comment -%} No category color available — skip swatch. {%- endcomment -%}
{%- else -%}
  {%- assign wa_color_parts = wa_color_data | split: '|' -%}
  {%- assign wa_swatch_name = wa_color_parts[0] | strip -%}
  {%- assign wa_swatch_css = wa_color_parts[1] | strip -%}
  {%- assign wa_swatch_image = wa_color_parts[2] | strip -%}
  {%- assign wa_swatch_name_lower = wa_swatch_name | downcase -%}
  {%- assign wa_swatch_is_light = false -%}
  {%- if wa_swatch_name_lower == 'white'
    or wa_swatch_name_lower == 'cream'
    or wa_swatch_name_lower == 'beige'
    or wa_swatch_name_lower == 'yellow'
    or wa_swatch_name_lower == 'ivory'
  -%}
    {%- assign wa_swatch_is_light = true -%}
  {%- endif -%}

  {%- assign wa_swatch_id = 'wa-color-swatch-' | append: section_id | append: '-' | append: swatch_product.id -%}
  {%- liquid
    assign wa_swatch_product_url = swatch_product.url
    if mode == 'card' and card_collection != blank
      assign wa_swatch_product_url = swatch_product.url | within: card_collection
    endif
    assign wa_swatch_url_separator = '?'
    if wa_swatch_product_url contains '?'
      assign wa_swatch_url_separator = '&'
    endif
    capture wa_card_context
      render 'wa-contextual-card-image', card_collection: card_collection
    endcapture
    assign wa_card_context = wa_card_context | strip
    if mode == 'card' and wa_card_context == 'womens'
      assign wa_swatch_product_url = wa_swatch_product_url | append: wa_swatch_url_separator | append: 'view_context=women'
    elsif mode == 'card' and wa_card_context == 'mens'
      assign wa_swatch_product_url = wa_swatch_product_url | append: wa_swatch_url_separator | append: 'view_context=men'
    elsif mode == 'product'
      capture wa_view_context
        render 'wa-product-view-context'
      endcapture
      assign wa_view_context = wa_view_context | strip
      if wa_view_context == 'women'
        assign wa_swatch_product_url = wa_swatch_product_url | append: wa_swatch_url_separator | append: 'view_context=women'
      elsif wa_view_context == 'men'
        assign wa_swatch_product_url = wa_swatch_product_url | append: wa_swatch_url_separator | append: 'view_context=men'
      endif
    endif
  -%}

  <div class="wa-color-swatch{% if is_active %} wa-color-swatch--active{% endif %}{% if wa_swatch_image != blank %} wa-color-swatch--pattern{% endif %}" role="listitem">
    {%- if is_active -%}
      <span
        id="{{ wa_swatch_id }}"
        class="wa-color-swatch__button"
        aria-current="true"
        aria-label="{{ wa_swatch_name }}, selected"
      >
        <span
          class="wa-color-swatch__circle{% if wa_swatch_is_light %} wa-color-swatch__circle--light{% endif %}{% if wa_swatch_css == blank and wa_swatch_image != blank %} wa-color-swatch__circle--image-only{% endif %}"
          style="{% if wa_swatch_css != blank %}--wa-swatch-color: {{ wa_swatch_css }};{% endif %}{% if wa_swatch_image != blank %} --wa-swatch-image: url({{ wa_swatch_image }});{% endif %}"
        ></span>
        <span class="visually-hidden">{{ wa_swatch_name }}</span>
      </span>
    {%- else -%}
      {%- liquid
        assign wa_preview_media = blank
        if mode == 'card'
          assign wa_preview_media = swatch_product.featured_media
          if wa_card_context == 'womens' and swatch_product.metafields.custom.womens_card_image.value != blank
            assign wa_preview_media = swatch_product.metafields.custom.womens_card_image.value
          elsif wa_card_context == 'mens' and swatch_product.metafields.custom.mens_card_image.value != blank
            assign wa_preview_media = swatch_product.metafields.custom.mens_card_image.value
          endif
        endif
        if wa_preview_media.image != blank
          assign wa_preview_media = wa_preview_media.image
        elsif wa_preview_media.preview_image != blank
          assign wa_preview_media = wa_preview_media.preview_image
        endif
        if wa_preview_media != blank
          assign wa_card_sizes = '(min-width: ' | append: settings.page_width | append: 'px) ' | append: settings.page_width | minus: 130 | divided_by: 4 | append: 'px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)'
        endif
      -%}
      {%- if wa_preview_media != blank -%}
        {%- capture wa_preview_srcset -%}
          {%- if wa_preview_media.width >= 165 -%}{{ wa_preview_media | image_url: width: 165 }} 165w,{%- endif -%}
          {%- if wa_preview_media.width >= 360 -%}{{ wa_preview_media | image_url: width: 360 }} 360w,{%- endif -%}
          {%- if wa_preview_media.width >= 533 -%}{{ wa_preview_media | image_url: width: 533 }} 533w,{%- endif -%}
          {%- if wa_preview_media.width >= 720 -%}{{ wa_preview_media | image_url: width: 720 }} 720w,{%- endif -%}
          {%- if wa_preview_media.width >= 940 -%}{{ wa_preview_media | image_url: width: 940 }} 940w,{%- endif -%}
          {%- if wa_preview_media.width >= 1066 -%}{{ wa_preview_media | image_url: width: 1066 }} 1066w,{%- endif -%}
          {{ wa_preview_media | image_url }} {{ wa_preview_media.width }}w
        {%- endcapture -%}
      {%- endif -%}
      <a
        id="{{ wa_swatch_id }}"
        href="{{ wa_swatch_product_url }}"
        class="wa-color-swatch__button wa-color-swatch__link"
        aria-label="View {{ wa_swatch_name | escape }}"
        {%- if wa_preview_media != blank %}
          data-wa-swatch-preview-src="{{ wa_preview_media | image_url: width: 533 }}"
          data-wa-swatch-preview-srcset="{{ wa_preview_srcset | strip }}"
          data-wa-swatch-preview-sizes="{{ wa_card_sizes }}"
          data-wa-swatch-preview-alt="{{ wa_preview_media.alt | default: swatch_product.title | escape }}"
        {%- endif -%}
      >
        <span
          class="wa-color-swatch__circle{% if wa_swatch_is_light %} wa-color-swatch__circle--light{% endif %}{% if wa_swatch_css == blank and wa_swatch_image != blank %} wa-color-swatch__circle--image-only{% endif %}"
          style="{% if wa_swatch_css != blank %}--wa-swatch-color: {{ wa_swatch_css }};{% endif %}{% if wa_swatch_image != blank %} --wa-swatch-image: url({{ wa_swatch_image }});{% endif %}"
        ></span>
        <span class="visually-hidden">{{ wa_swatch_name }}</span>
      </a>
    {%- endif -%}
  </div>
{%- endif -%}
